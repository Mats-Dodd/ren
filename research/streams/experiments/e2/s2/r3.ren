// a block-taking gen fn's pipeline, passed down into a concurrent block
// that steps it: the existing rule for a let-bound block that writes
gen fn evens(src: fn() -> Option<Int>) -> Int =
  for x in try src
    if x % 2 == 0 then yield x

gen fn upto(n: Int) -> Int =
  var i = 0
  while i < n
    yield i
    i += 1

fn main() uses Console, Async =
  let p = evens(upto(10).map(fn(x) => x))
  Async.each([1, 2], fn(x) => print(p()))
