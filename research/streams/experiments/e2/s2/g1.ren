// a pure gen fn taking only values: a value cursor, storable, a copy forks
type Tree =
  | Leaf
  | Node(l: Tree, v: Int, r: Tree)

gen fn walk(t: Tree) -> Int =
  match t
    Leaf => ()
    Node(l, v, r) =>
      yield from walk(l)
      yield v
      yield from walk(r)

gen fn upto(n: Int) -> Int =
  var i = 0
  while i < n
    yield i
    i += 1

type Job = { name: Str, rest: Gen<Int> }

fn main() uses Console =
  let t = Node(Node(Leaf, 1, Leaf), 2, Node(Leaf, 3, Node(Leaf, 4, Leaf)))
  for x in walk(t)
    print(x)
  var c = upto(5)
  print(&c.next())
  print(&c.next())
  var d = c
  print(&d.next())
  print(&d.next())
  print(&c.next())
  let job = Job { name: "j", rest: c }
  let rest = job.rest
  for x in rest
    print(x)
  print(walk(t).map(fn(x) => x * 10).select(fn(x) => x > 10).to_array())
