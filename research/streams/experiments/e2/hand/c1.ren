type Each = { xs: Array<Int>, i: Int }
  fn next(inout self) -> Option<Int> =
    if self.i < self.xs.len() then
      self.i += 1
      Some(self.xs[self.i - 1])
    else None
fn consume(p: fn() -> Option<Int>, inout limit: Int) -> Int =
  var total = 0
  var go = true
  while go
    match try p()
      None => go = false
      Some(x) =>
        total += x
        limit += 1
  total
fn main() uses Console =
  var limit = 3
  var src = Each { xs: [1, 2, 3, 4, 5], i: 0 }
  let sel = fn() =>
    var out = None
    var go = true
    while go
      match &src.next()
        None => go = false
        Some(x) =>
          if x < limit then
            out = Some(x)
            go = false
    out
  print(consume(sel, &limit))
