type Each = { xs: Array<Int>, i: Int }
  fn next(inout self) -> Option<Int> =
    if self.i < self.xs.len() then
      self.i += 1
      Some(self.xs[self.i - 1])
    else None
fn keep<T>(x: T) -> T = x
fn main() uses Console =
  var r = Each { xs: [1, 2, 3], i: 0 }
  let p = fn() => &r.next()
  let k = keep(p)
  print(k())
