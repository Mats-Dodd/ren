type Each = { xs: Array<Int>, i: Int }
  fn next(inout self) -> Option<Int> =
    if self.i < self.xs.len() then
      self.i += 1
      Some(self.xs[self.i - 1])
    else None

type Nums = { xs: Array<Int> }
  fn cursor(self) -> Each = Each { xs: self.xs, i: 0 }
fn consume(rows: fn() -> Option<Int>, inout limit: Int) -> Int =
  var total = 0
  for x in try rows
    total += x
    limit += 1
  total
fn main() uses Console =
  let xs = Nums { xs: [1, 2, 3, 4, 5] }
  var limit = 3
  print(consume(xs.cursor().select(fn(x) => x < limit), &limit))
