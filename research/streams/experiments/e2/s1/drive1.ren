type Each = { xs: Array<Int>, i: Int }
  fn next(inout self) -> Option<Int> =
    if self.i < self.xs.len() then
      self.i += 1
      Some(self.xs[self.i - 1])
    else None

type Nums = { xs: Array<Int> }
  fn cursor(self) -> Each = Each { xs: self.xs, i: 0 }
fn bump(inout n: Int, p: fn() -> Option<Int>) -> Int =
  n += 1
  0
fn drive(c: fn() -> Option<Int>, k: fn(fn() -> Option<Int>) -> Int) -> Int = try k(c)
fn main() uses Console =
  let ns = Nums { xs: [1, 2, 3] }
  var n = 0
  print(drive(ns.cursor().map(fn(x) =>
    n += 1
    x), fn(p) => bump(&n, p)))
