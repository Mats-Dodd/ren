+(* SPIKE (syntax/streams.ml): generators, each on a one-shot fiber.
+
+   A pipeline's frame, [Gen_frame_v], is a hidden local of its caller:
+   started by its first step, suspended at each `yield`, resumed by the
+   next step, never copied by a program, since no program can name it.
+   A value cursor, [Gen_cursor_v], is a value: its generator, the
+   arguments it captured, and how many items it has given. Its `next`
+   continues the one live fiber if that fiber is exactly where this copy
+   is ([cache]), and otherwise replays the generator from the start,
+   skipping what this copy has given: so a copy is an honest fork. *)
+type gen_step = Yielded of Value.t | Ended of (Value.t, Value.t) result
+type _ Effect.t += Gen_yield_eff : Value.t -> unit Effect.t
+type gen_k = (unit, gen_step) Effect.Deep.continuation
+type frame_state = Unstarted | Suspended of gen_k | Over
+
+type gen_cursor = {
+  start : unit -> (Value.t, Value.t) result;
+  pos : int;
+  cache : (int * gen_k) option ref;
+}
+
+type Value.sched += Gen_frame_v of frame_state ref | Gen_cursor_v of gen_cursor
+
+let gen_fiber (body : unit -> (Value.t, Value.t) result) ~(on_yield : gen_k -> unit) =
+  Effect.Deep.match_with body ()
+    {
+      retc = (fun r -> Ended r);
+      exnc = raise;
+      effc =
+        (fun (type a) (eff : a Effect.t) ->
+          match eff with
+          | Gen_yield_eff v ->
+              Some
+                (fun (k : (a, gen_step) Effect.Deep.continuation) ->
+                  on_yield k;
+                  Yielded v)
+          | _ -> None);
+    }
