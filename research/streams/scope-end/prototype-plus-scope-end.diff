+            c.cache := None;
+            Effect.Deep.continue k ()
+        | None -> bug "a generator's fiber that's gone"
+      in
+      let step =
+        match !(c.cache) with
+        | Some (p, _) when p = c.pos -> take ()
+        | _ ->
+            (* replay: a fresh fiber, past the items this copy has given *)
+            let count = ref 0 in
+            let first =
+              gen_fiber c.start ~on_yield:(fun k ->
+                  incr count;
+                  c.cache := Some (!count, k))
+            in
+            let rec skip = function
+              | Yielded _ when !count <= c.pos -> skip (take ())
+              | s -> s
+            in
+            skip first
+      in
