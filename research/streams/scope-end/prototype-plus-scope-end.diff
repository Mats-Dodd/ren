index 0000000..74db331
--- /dev/null
+++ b/lib/syntax/streams.ml
@@ -0,0 +1,616 @@
+(* SPIKE (streams E2): "a pipeline is a block" and "a gen fn call follows
+   its signature", written as a rewrite of the parsed tree, so that every
+   existing check (resolve, infer, exclusivity, Core Lint) runs unchanged
+   on exactly the code the compiler would write.
+
+   A real implementation would do this in inference, by type: here a
+   chain is recognised by its spelling (an `&place` head, a `.cursor()`
+   head, a gen fn call, or a name known to be a pipeline), which is the
+   spike's main shortcut.
+
+   - A chain `&r.map(f).select(p).take(n)` becomes a literal block,
+     `fn() => PULL`, whose stage state (`take`'s counter) is a hidden local
+     (`$`-named) declared just before the statement the chain is in.
+   - `for x in CHAIN` is fused: a `while` over PULL, no block at all.
+   - `for x in p`, where `p` is a let-bound pipeline or a parameter
+     written `fn() -> ...`, is a `while` over `p()`.
+   - A sink, `.to_array()` or `.count()`, ends a chain in a loop.
+   - A gen fn takes a hidden last parameter, `$w: GenYield<T>`, and
+     `yield e` is `$gen_yield(e, $w)` (parser.ml). A call of a pure gen fn
+     taking only values is a value cursor, `$gen_cursor(fn($w) => g(.., $w))`;
+     any other's is a pipeline: a hidden `var $g = $gen_frame()` and the
+     block `fn() => $gen_resume(&$g, fn($w) => g(.., $w))`, run on a
+     one-shot fiber by the interpreter (eval.ml). *)
+
+open Ast
+open Ast.Parsed
+
+type gen_kind = Value_gen | Pipeline_gen
+
+(* the module's gen fns, by name, which the parser fills *)
+let gens : (string, gen_kind) Hashtbl.t = Hashtbl.create 8
+
+(* compiler-written `try`s, which may cover nothing: numbered below -1,
+   once in the whole program, so no two share a node (infer_expr.ml) *)
+let quiet = ref (-2)
+
+let quiet_node () =
+  decr quiet;
+  !quiet
+
+(* the pipeline frames started while a `for`'s source is written *)
+let opened : string list ref = ref []
+
+type st = { mutable node : int }
+
+let mk st kind loc : expr =
+  st.node <- st.node + 1;
+  { kind; loc; node = st.node }
+
+let pat st pkind ploc : pattern =
+  st.node <- st.node + 1;
+  { pkind; ploc; pnode = st.node }
+
+let fresh st base =
+  st.node <- st.node + 1;
+  Printf.sprintf "$%s%d" base st.node
+
+let id name loc : ident = { name; loc }
+let var st n loc = mk st (Var (Bare n)) loc
+let call st f args loc = mk st (Call (f, args)) loc
+let meth st recv m args loc = call st (mk st (Field (recv, id m loc)) loc) args loc
+let ctor n loc : ctor_ref = { qual = None; name = id n loc }
+let some st e loc = mk st (Con (ctor "Some" loc, [ (None, e) ])) loc
+let none st loc = mk st (Con (ctor "None" loc, [])) loc
+let unit st loc = mk st Unit loc
+let bool st b loc = mk st (Bool b) loc
+let int st n loc = mk st (Int (Int64.of_int n)) loc
+
+let let_ ?(mut = false) ?ty n (v : expr) =
+  Let { name = id n v.loc; ty; value = v; mut }
+
+let assign st ?op target value loc =
+  st.node <- st.node + 1;
+  let onode = st.node in
+  mk st (Assign { target; op; value; onode }) loc
+
+let block st stmts last loc =
+  if stmts = [] then last else mk st (Block (stmts, last)) loc
+
+let arm p body : arm = { arm_pat = p; arm_guard = None; arm_body = body }
+
+let quiet_try (e : expr) : expr =
+  { kind = Try e; loc = e.loc; node = quiet_node () }
+
+let binop st op a b loc =
+  st.node <- st.node + 1;
+  let o = st.node in
+  mk st (Binop (op, a, b, o)) loc
+
+(* `match UP` with `None => none_case` and `Some(x) => some_case x` *)
+let match_opt st up ~none_case ~some_case loc =
+  let x = fresh st "x" in
+  mk st
+    (Match
+       ( up,
+         [
+           arm (pat st (PCon (ctor "None" loc, [])) loc) none_case;
+           arm
+             (pat st (PCon (ctor "Some" loc, [ pat st (PVar (id x loc)) loc ])) loc)
+             (some_case (var st x loc));
+         ] ))
+    loc
+
+(* ---- what's a pipeline ---- *)
+
+let stages = [ "map"; "select"; "take"; "take_while"; "with_index" ]
+let sinks = [ "to_array"; "count" ]
+let is_stage m = List.mem m stages
+let is_sink m = List.mem m sinks
+
+(* [e] as a head and its stages, in order *)
+let rec spine (e : expr) =
+  match e.kind with
+  | Call ({ kind = Field (recv, m); _ }, args)
+    when (is_stage m.name || is_sink m.name)
+         && List.length args
+            = (if m.name = "with_index" || is_sink m.name then 0 else 1) ->
+      let h, ss = spine recv in
+      (h, ss @ [ (m.name, args, e.loc) ])
+  | _ -> (e, [])
+
+type env = { pulls : string list }
+
+let is_pull_ty (t : ty option) =
+  match t with Some (TyFn ([], Some _, _, _, _)) -> true | _ -> false
+
+let gen_call (e : expr) =
+  match e.kind with
+  | Call (_, args)
+    when match List.rev args with
+         | { kind = Var (Bare "$w"); _ } :: _ -> true (* `yield from` *)
+         | _ -> false ->
+      None
+  | Call ({ kind = Var (Bare g); _ }, args) -> (
+      match Hashtbl.find_opt gens g with Some k -> Some (g, args, k) | None -> None)
+  | Try { kind = Call ({ kind = Var (Bare g); _ }, args); _ } -> (
+      match Hashtbl.find_opt gens g with
+      | Some k -> Some (g, args, k)
+      | None -> None)
+  | _ -> None
+
+type source =
+  | Place of expr  (** `&r`: [r.next()] steps [r] itself *)
+  | Temp of expr  (** a cursor value, held in a hidden `var` *)
+  | Pull of string  (** a pipeline already: call it *)
+  | Gen_pipeline of string * expr list
+
+let source env (head : expr) ~under_ref =
+  if under_ref then
+    match head.kind with Var _ | Field _ | Index _ -> Some (Place head) | _ -> None
+  else
+    match head.kind with
+    | Call ({ kind = Field (_, { name = "cursor"; _ }); _ }, []) -> Some (Temp head)
+    | Var (Bare n) when List.mem n env.pulls -> Some (Pull n)
+    | _ -> (
+        match gen_call head with
+        | Some (_, _, Value_gen) -> Some (Temp head)
+        | Some (g, args, Pipeline_gen) -> Some (Gen_pipeline (g, args))
+        | None -> None)
+
+(* Whether [e] is a pipeline: what a `let` of it makes known as one. *)
+let is_pipeline env (e : expr) =
+  let under_ref, inner = match e.kind with Ref i -> (true, i) | _ -> (false, e) in
+  let h, ss = spine inner in
+  match ss with
+  | [] -> (
+      (not under_ref)
+      && match gen_call e with Some (_, _, Pipeline_gen) -> true | _ -> false)
+  | _ ->
+      (match List.rev ss with (m, _, _) :: _ -> not (is_sink m) | [] -> false)
+      && source env h ~under_ref <> None
+
+(* ---- the rewrite ---- *)
+
+let rec expr st env (h : stmt list ref) (e : expr) : expr =
+  let re = expr st env h in
+  let sc = scoped st env in
+  let chain_of ~under_ref inner =
+    let head, ss = spine inner in
+    match ss with
+    | [] -> None
+    | _ -> (
+        match source env head ~under_ref with
+        | None -> None
+        | Some src -> Some (src, ss))
+  in
+  match e.kind with
+  | Ref inner -> (
+      match chain_of ~under_ref:true inner with
+      | Some (src, ss) -> compile_value st env h src ss e.loc
+      | None -> { e with kind = Ref (re inner) })
+  | Call ({ kind = Field (_, m); _ }, _) when is_stage m.name || is_sink m.name
+    -> (
+      match chain_of ~under_ref:false e with
+      | Some (src, ss) -> compile_value st env h src ss e.loc
+      | None -> map_children st env h e)
+  | Call ({ kind = Var (Bare g); _ }, args)
+    when Hashtbl.mem gens g
+         && not
+              (match List.rev args with
+              | { kind = Var (Bare "$w"); _ } :: _ -> true (* `yield from` *)
+              | _ -> false) -> (
+      let args = List.map re args in
+      match Hashtbl.find gens g with
+      | Value_gen -> value_cursor st h g args e.loc
+      | Pipeline_gen ->
+          let pull = gen_pull st h g args e.loc in
+          mk st (Lambda ([], quiet_try pull)) e.loc)
+  | For { index = None; pat = p; over = Each iter; body } -> (
+      let tried, it =
+        match iter.kind with Try i -> (Some iter, i) | _ -> (None, iter)
+      in
+      let under_ref, inner =
+        match it.kind with Ref i -> (true, i) | _ -> (false, it)
+      in
+      let found =
+        match chain_of ~under_ref inner with
+        | Some (src, ss)
+          when (match List.rev ss with (m, _, _) :: _ -> not (is_sink m) | _ -> false) ->
+            Some (fun () -> pull_of st env h src ss e.loc)
+        | _ -> (
+            match (it.kind, gen_call it) with
+            | _, Some (g, args, Pipeline_gen) ->
+                Some (fun () -> gen_pull st h g (List.map re args) e.loc)
+            | Var (Bare n), _ when List.mem n env.pulls ->
+                Some (fun () -> call st (var st n it.loc) [] it.loc)
+            | _ -> None)
+      in
+      match found with
+      | Some pull ->
+          let was = !opened in
+          opened := [];
+          let up = pull () in
+          let frames = !opened in
+          opened := was;
+          let up =
+            match tried with Some t -> { t with kind = Try up } | None -> up
+          in
+          let l = loop st up p (sc body) e.loc in
+          (* the frames this `for` started over its temporaries end with
+             it, after a `break` too: each generator's `finally` runs *)
+          let close f =
+            Expr
+              (call st (var st "$gen_close" e.loc)
+                 [ mk st (Ref (var st f e.loc)) e.loc ]
+                 e.loc)
+          in
+          if frames = [] then l
+          else block st (Expr l :: List.map close frames) (unit st e.loc) e.loc
+      | None -> for_generic st env h e)
+  | Block (ss, last) ->
+      let ss, last = stmts st env ss last in
+      { e with kind = Block (ss, last) }
+  | Lambda (ps, body) ->
+      let env =
+        {
+          pulls =
+            List.filter_map
+              (fun (q : param) -> if is_pull_ty q.pty then Some q.pname.name else None)
+              ps
+            @ env.pulls;
+        }
+      in
+      { e with kind = Lambda (ps, scoped st env body) }
+  | If (c, t, f) -> { e with kind = If (re c, sc t, Option.map sc f) }
+  | Match (s, arms) ->
+      {
+        e with
+        kind =
+          Match
+            ( re s,
+              List.map
+                (fun a ->
+                  { a with arm_guard = Option.map sc a.arm_guard; arm_body = sc a.arm_body })
+                arms );
+      }
+  | While { cond; body } -> { e with kind = While { cond = sc cond; body = sc body } }
+  | For _ -> for_generic st env h e
+  | With { items; body } ->
+      let items =
+        List.map
+          (fun i -> { i with chain = List.map (fun l -> { l with link = re l.link }) i.chain })
+          items
+      in
+      { e with kind = With { items; body = sc body } }
+  | _ -> map_children st env h e
+
+and for_generic st env h (e : expr) : expr =
+  match e.kind with
+  | For { index; pat = p; over; body } ->
+      let over =
+        match over with
+        | Each i -> Each (expr st env h i)
+        | Range (a, b) -> Range (expr st env h a, expr st env h b)
+      in
+      { e with kind = For { index; pat = p; over; body = scoped st env body } }
+  | _ -> e
+
+and map_children st env h (e : expr) : expr =
+  let re = expr st env h in
+  let kind =
+    match e.kind with
+    | Int _ | Float _ | Bool _ | Str _ | Unit | Var _ | Break | Tag_set _ -> e.kind
+    | Unop (o, a, n) -> Unop (o, re a, n)
+    | Binop (o, a, b, n) -> Binop (o, re a, re b, n)
+    | Call (f, args) -> Call (re f, List.map re args)
+    | Con (c, args) -> Con (c, List.map (fun (n, a) -> (n, re a)) args)
+    | Record (t, fs) -> Record (t, List.map (fun (n, a) -> (n, re a)) fs)
+    | Field (a, f) -> Field (re a, f)
+    | Array xs -> Array (List.map re xs)
+    | Tuple xs -> Tuple (List.map re xs)
+    | Index (a, b) -> Index (re a, re b)
+    | Slice (a, b, c) -> Slice (re a, re b, re c)
+    | Ref a -> Ref (re a)
+    | Assign a -> Assign { a with target = re a.target; value = re a.value }
+    | Fail (t, args) -> Fail (t, List.map (fun (n, a) -> (n, re a)) args)
+    | Try a -> Try (re a)
+    | Attempt a -> Attempt (re a)
+    | Assert a -> Assert (re a)
+    | Named (n, a) -> Named (n, re a)
+    | Inline_handler a -> Inline_handler (re a)
+    | Handler hd ->
+        Handler
+          {
+            hd with
+            state = List.map (stmt_shallow st env) hd.state;
+            arms = List.map (fun a -> { a with arm_impl = re a.arm_impl }) hd.arms;
+          }
+    | Lambda _ | Block _ | If _ | Match _ | While _ | For _ | With _ ->
+        (expr st env h e).kind
+  in
+  { e with kind }
+
+and stmt_shallow st env (s : stmt) : stmt =
+  let sc = scoped st env in
+  match s with
+  | Let l -> Let { l with value = sc l.value }
+  | Let_tuple l -> Let_tuple { l with value = sc l.value }
+  | Expr e -> Expr (sc e)
+  | Finally e -> Finally (sc e)
+
+(* [e] in a scope of its own: what it hoists goes just before it *)
+and scoped st env (e : expr) : expr =
+  match e.kind with
+  | Block (ss, last) ->
+      let ss, last = stmts st env ss last in
+      { e with kind = Block (ss, last) }
+  | _ ->
+      let h = ref [] in
+      let e' = expr st env h e in
+      block st (List.rev !h) e' e.loc
+
+and stmts st env ss last =
+  let rec go env acc = function
+    | [] ->
+        let h = ref [] in
+        let last' = expr st env h last in
+        (List.rev acc @ List.rev !h, last')
+    | s :: rest ->
+        let h = ref [] in
+        let s', env =
+          match s with
+          | Let l ->
+              let pipe = is_pipeline env l.value in
+              let v = expr st env h l.value in
+              ( Let { l with value = v },
+                if pipe then { pulls = l.name.name :: env.pulls } else env )
+          | Let_tuple l -> (Let_tuple { l with value = expr st env h l.value }, env)
+          | Expr e -> (Expr (expr st env h e), env)
+          | Finally e -> (Finally (expr st env h e), env)
+        in
+        go env ((s' :: !h) @ acc) rest
+  in
+  go env [] ss
+
+(* A chain in a value's place: a block, or a sink's loop. *)
+and compile_value st env h src ss loc =
+  match List.rev ss with
+  | (m, _, sloc) :: before when is_sink m ->
+      let up = pull_of st env h src (List.rev before) loc in
+      sink st m up sloc
+  | _ ->
+      let up = pull_of st env h src ss loc in
+      mk st (Lambda ([], quiet_try up)) loc
+
+(* The expression that, evaluated, gives the chain's next item. *)
+and pull_of st env h src ss loc =
+  let head =
+    match src with
+    | Place r -> mk st (Ref (meth st (expr st env h r) "next" [] loc)) loc
+    | Temp c ->
+        let c = expr st env h c in
+        let n = fresh st "src" in
+        h := let_ ~mut:true n c :: !h;
+        mk st (Ref (meth st (var st n loc) "next" [] loc)) loc
+    | Pull n -> call st (var st n loc) [] loc
+    | Gen_pipeline (g, args) -> gen_pull st h g (List.map (expr st env h) args) loc
+  in
+  List.fold_left (fun up s -> stage st env h up s) head ss
+
+(* [f] applied to [x]: a literal block inlined, `{ let p = x; body }`;
+   anything else called *)
+and apply st env h (f : expr) (x : expr) loc =
+  match f.kind with
+  | Lambda ([ q ], body) ->
+      let body = scoped st env body in
+      block st [ Let { name = q.pname; ty = q.pty; value = x; mut = false } ] body loc
+  | _ -> call st (expr st env h f) [ x ] loc
+
+and hoist_value st env h (a : expr) =
+  match a.kind with
+  | Int _ | Var _ -> expr st env h a
+  | _ ->
+      let n = fresh st "arg" in
+      h := let_ n (expr st env h a) :: !h;
+      var st n a.loc
+
+and stage st env h up (m, args, loc) =
+  match (m, args) with
+  | "map", [ f ] ->
+      match_opt st up ~none_case:(none st loc)
+        ~some_case:(fun x -> some st (apply st env h f x loc) loc)
+        loc
+  | "select", [ f ] ->
+      (* `{ var out = None; var go = true; while go: match UP ... ; out }` *)
+      let out = fresh st "out" and go = fresh st "go" in
+      let stop = assign st (var st go loc) (bool st false loc) loc in
+      let body =
+        match_opt st up ~none_case:stop
+          ~some_case:(fun x ->
+            mk st
+              (If
+                 ( apply st env h f x loc,
+                   block st
+                     [ Expr (assign st (var st out loc) (some st x loc) loc) ]
+                     stop loc,
+                   None ))
+              loc)
+          loc
+      in
+      block st
+        [
+          let_ ~mut:true out (none st loc);
+          let_ ~mut:true go (bool st true loc);
+          Expr (mk st (While { cond = var st go loc; body }) loc);
+        ]
+        (var st out loc) loc
+  | "take", [ n ] ->
+      let n = hoist_value st env h n in
+      let taken = fresh st "taken" in
+      h := let_ ~mut:true taken (int st 0 loc) :: !h;
+      mk st
+        (If
+           ( binop st Lt (var st taken loc) n loc,
+             match_opt st up ~none_case:(none st loc)
+               ~some_case:(fun x ->
+                 block st
+                   [ Expr (assign st ~op:Add (var st taken loc) (int st 1 loc) loc) ]
+                   (some st x loc) loc)
+               loc,
+             Some (none st loc) ))
+        loc
+  | "take_while", [ f ] ->
+      let fin = fresh st "done" in
+      h := let_ ~mut:true fin (bool st false loc) :: !h;
+      mk st
+        (If
+           ( var st fin loc,
+             none st loc,
+             Some
+               (match_opt st up ~none_case:(none st loc)
+                  ~some_case:(fun x ->
+                    mk st
+                      (If
+                         ( apply st env h f x loc,
+                           some st x loc,
+                           Some
+                             (block st
+                                [ Expr (assign st (var st fin loc) (bool st true loc) loc) ]
+                                (none st loc) loc) ))
+                      loc)
+                  loc) ))
+        loc
+  | "with_index", [] ->
+      let i = fresh st "i" and j = fresh st "j" in
+      h := let_ ~mut:true i (int st 0 loc) :: !h;
+      match_opt st up ~none_case:(none st loc)
+        ~some_case:(fun x ->
+          block st
+            [
+              let_ j (var st i loc);
+              Expr (assign st ~op:Add (var st i loc) (int st 1 loc) loc);
+            ]
+            (some st (mk st (Tuple [ var st j loc; x ]) loc) loc)
+            loc)
+        loc
+  | _ -> Diag.error loc (Printf.sprintf "spike: the stage `%s` isn't written" m)
+
+(* `for p in ..` over [up]: `var go = true; while go: match up ...` *)
+and loop st up (p : pattern) body loc =
+  let go = fresh st "go" in
+  let stop = assign st (var st go loc) (bool st false loc) loc in
+  let some_arm =
+    arm (pat st (PCon (ctor "Some" loc, [ p ])) loc)
+      (block st [ Expr body ] (unit st loc) loc)
+  in
+  let none_arm = arm (pat st (PCon (ctor "None" loc, [])) loc) stop in
+  block st
+    [
+      let_ ~mut:true go (bool st true loc);
+      Expr
+        (mk st
+           (While { cond = var st go loc; body = mk st (Match (up, [ none_arm; some_arm ])) loc })
+           loc);
+    ]
+    (unit st loc) loc
+
+and sink st m up loc =
+  let acc = fresh st "acc" and go = fresh st "go" in
+  let stop = assign st (var st go loc) (bool st false loc) loc in
+  let init, add =
+    match m with
+    | "to_array" ->
+        ( mk st (Array []) loc,
+          fun x -> mk st (Ref (meth st (var st acc loc) "push" [ x ] loc)) loc )
+    | _ ->
+        ( int st 0 loc,
+          fun _ -> assign st ~op:Add (var st acc loc) (int st 1 loc) loc )
+  in
+  block st
+    [
+      let_ ~mut:true acc init;
+      let_ ~mut:true go (bool st true loc);
+      Expr
+        (mk st
+           (While
+              {
+                cond = var st go loc;
+                body = match_opt st up ~none_case:stop ~some_case:add loc;
+              })
+           loc);
+    ]
+    (var st acc loc) loc
+
+(* a pure gen fn's call: a value cursor of its own arguments *)
+and value_cursor st h g args loc =
+  let held = List.map (fun (a : expr) ->
+      match a.kind with
+      | Int _ | Str _ | Bool _ -> a
+      | _ ->
+          let n = fresh st "arg" in
+          h := let_ n a :: !h;
+          var st n a.loc) args
+  in
+  let w = id "$w" loc in
+  let start =
+    mk st
+      (Lambda
+         ( [ { pname = w; pty = None; pmode = Read; pblock = Ordinary; pdefault = None } ],
+           call st (var st g loc) (held @ [ var st "$w" loc ]) loc ))
+      loc
+  in
+  call st (var st "$gen_cursor" loc) [ start ] loc
+
+(* a pipeline gen fn's call: its frame a hidden local, resumed by each
+   pull *)
+and gen_pull st h g args loc =
+  let held =
+    List.map
+      (fun (a : expr) ->
+        match a.kind with
+        | Int _ | Str _ | Bool _ | Var _ -> a
+        | _ ->
+            let n = fresh st "arg" in
+            h := let_ n a :: !h;
+            var st n a.loc)
+      args
+  in
+  let frame = fresh st "frame" in
+  opened := frame :: !opened;
+  h := let_ ~mut:true frame (call st (var st "$gen_frame" loc) [] loc) :: !h;
+  let w = id "$w" loc in
+  let start =
+    mk st
+      (Lambda
+         ( [ { pname = w; pty = None; pmode = Read; pblock = Ordinary; pdefault = None } ],
+           quiet_try (call st (var st g loc) (held @ [ var st "$w" loc ]) loc) ))
+      loc
+  in
+  call st (var st "$gen_resume" loc) [ mk st (Ref (var st frame loc)) loc; start ] loc
+
+(* ---- items ---- *)
+
+let fn_def st (f : fn_def) =
+  let env =
+    {
+      pulls =
+        List.filter_map
+          (fun (q : param) -> if is_pull_ty q.pty then Some q.pname.name else None)
+          f.params;
+    }
+  in
+  { f with body = scoped st env f.body }
+
+let item ~node (i : item) : item =
+  let st = { node } in
+  match i with
+  | Fn f -> Fn (fn_def st f)
+  | Type t ->
+      Type
+        {
+          t with
+          type_ops =
+            List.map (fun (o : op) -> { o with op_fn = fn_def st o.op_fn }) t.type_ops;
+        }
+  | i -> i
