+        match step with
+        | Yielded v -> (Ok (some v), { c with pos = c.pos + 1 })
+        | Ended (Ok _) -> (Ok none, c)
+        | Ended (Error e) -> (Error e, c)
+      in
+      (r, [ VSched (Gen_cursor_v c') ])
+  | _ -> bug "a generator's built-in given the wrong values"
