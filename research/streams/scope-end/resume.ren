// one named generator resumed across two loops (streams.md, `sections`),
// then the scope ends
gen fn src(name: Str, n: Int) -> Int uses Console =
  print((name, "first step"))
  finally(r) =>
    print((name, "finally", r))
  var i = 0
  while i < n
    yield i
    i += 1

fn drained() uses Console =
  let g = src("drained", 4)
  for x in g
    print(("first loop", x))
    if x == 1 then break
  for x in g
    print(("second loop", x))
  print("end of scope: already finished, nothing to close")

fn left_open() uses Console =
  let g = src("open", 10)
  for x in g
    print(("first loop", x))
    if x == 1 then break
  for x in g
    print(("second loop", x))
    if x == 3 then break
  print("end of scope: still suspended")

fn main() uses Console =
  drained()
  print("--")
  left_open()
