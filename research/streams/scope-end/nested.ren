// nested scopes, and several generators in one scope: each closes at the
// end of its own `let`'s scope, the inner first; two in one scope close
// in the reverse of the order they were named
gen fn src(name: Str, n: Int) -> Int uses Console =
  print((name, "first step"))
  finally(r) =>
    print((name, "finally", r))
  var i = 0
  while i < n
    yield i
    i += 1

fn main() uses Console =
  let a = src("a", 10)
  print(("a", a()))
  let b = src("b", 10)
  print(("b", b()))
  if true then
    let inner = src("inner", 10)
    print(("inner", inner()))
    print("end of the if's scope")
  for k in 0..2
    let per = src("per round", 10)
    print(("per round", k, per()))
  print("end of main's scope")
