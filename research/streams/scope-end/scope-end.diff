diff --git a/lib/lower/lower.ml b/lib/lower/lower.ml
index ee9f9e2..9e220a0 100644
--- a/lib/lower/lower.ml
+++ b/lib/lower/lower.ml
@@ -1958,11 +1958,28 @@ and plain_call cx ~changed ?callee (e : expr) f args =
 and block cx stmts last =
   match stmts with
   | [] -> expr cx last
-  | Let { name; value; _ } :: rest ->
+  | Let { name; value; _ } :: rest -> (
       let value = expr cx value in
       let v = bind cx name value.ty in
       let body = block cx rest last in
-      mk (Let (v, value, body)) body.ty value.loc
+      match value.kind with
+      | Call ({ kind = Intrinsic (Gen_frame, a, ds, dicts); _ }, [], _) ->
+          (* SPIKE (streams rule 5): a generator's frame is a scope. It's
+             closed when the scope of the hidden `var` that holds it ends,
+             by any exit: falling off the end, a `break` out of a loop
+             around it, a failure, a cancel. Closing one that's over, or
+             was never stepped, does nothing. *)
+          let close_ty =
+            Ty.Fun ([ { mode = Inout; ty = value.ty } ], Ty.unit, Ty.closed, Ty.closed)
+          in
+          let close =
+            mk
+              (Call
+                 (mk (Intrinsic (Gen_close, a, ds, dicts)) close_ty value.loc, [ Ref v ], cx.ev))
+              Ty.unit value.loc
+          in
+          mk (Let (v, value, mk (Finally (body, close)) body.ty body.loc)) body.ty value.loc
+      | _ -> mk (Let (v, value, body)) body.ty value.loc)
   | Let_tuple { pat; value } :: rest ->
       let value = expr cx value in
       take_apart cx pat value (fun () -> block cx rest last)
