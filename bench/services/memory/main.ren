// The services stage's milestone, part three (compiler.md, "Services
// stage"): a document that keeps its text only in memory, with no
// write-through. Its first test passes under any schedule, since nothing
// is evicted below `max:`; its second installs the same family with
// chaos eviction, `actors(doc, chaos: true)`, which evicts the evictable
// actors `Random` picks at each call into the family, from the tape
// under `ren test`: some seed of `ren test --seeds 200` evicts it between
// two sessions and the second finds the text gone, and `--seed` with it
// fails the same way again.

pub type DocId = | DocId(name: Str)

pub dep Doc =
  add: fn(s: Str)
  text: fn() -> Str

pub handler doc(id: DocId) for Doc =
  var text = ""
  add(s) => text = text.concat(s)
  text() => text

pub dep Docs = Actors<DocId, Doc>

test "without chaos, every edit is still there" =
  with actors(doc) as Docs in
    Async.scope fn(s) =>
      s.spawn fn() => Docs.at(DocId("a")) fn() => Doc.add("x")
      s.spawn fn() => Docs.at(DocId("a")) fn() => Doc.add("y")
    Docs.at(DocId("a")) fn() =>
      assert Doc.text().bytes().len() == 2

test "under chaos, every edit is still there" =
  with actors(doc, chaos: true) as Docs in
    Async.scope fn(s) =>
      s.spawn fn() => Docs.at(DocId("a")) fn() => Doc.add("x")
      s.spawn fn() => Docs.at(DocId("a")) fn() => Doc.add("y")
    Docs.at(DocId("a")) fn() =>
      assert Doc.text().bytes().len() == 2
