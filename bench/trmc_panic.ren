// A list built by a loop that fills a hole (trmc.ml) that panics part
// way: an `Int` overflows on the 11th turn, with the ten cells of the
// turns before it built, where the recursion would have built none yet.
// The panic is the same as `ren run`'s, at the same place. build.t runs it under the sanitizers, in both builds and both
// countings.

type List =
  | Cons { head: Int, tail: List }
  | Nil

fn build(i: Int, n: Int) -> List =
  if i == n then Nil else Cons { head: i * 1000000000000000000, tail: build(i + 1, n) }

fn len(l: List) -> Int =
  match l
    Cons { tail: t, .. } => 1 + len(t)
    Nil => 0

fn main() uses Console =
  print(len(build(0, 9)))
  print(len(build(0, 12)))
