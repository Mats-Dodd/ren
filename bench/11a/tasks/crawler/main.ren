// A crawler (async.md, "A crawler"): the links below a page are crawled
// at once, a task each, every url is claimed once, and at most 16
// requests reach the web at a time, however deep the crawl goes.

import sync

pub type Page = { url: Str, links: Array<Str> }

pub dep Web =
  get: fn(url: Str) -> Page ! Unreachable(url: Str)

dep Seen =
  // true the first time a url is claimed
  claim: fn(url: Str) -> Bool

// the urls claimed so far: two tasks can't both claim one, since an
// operation keeps its instance until it returns
handler seen_set() for Seen =
  var seen: Set<Str> = Set.of([])
  claim(url) =>
    if seen.includes(url) then false
    else
      &seen.add(url)
      true

// the pages from `url` down, `depth` links deep; a page that can't be
// fetched is skipped
fn crawl(url: Str, depth: Int) -> Array<Page> uses Web, Seen, Async =
  if depth == 0 || not Seen.claim(url) then []
  else
    match attempt Web.get(url)
      Err(_) => []
      Ok(page) =>
        let below = Async.map(page.links) fn(link) => crawl(link, depth - 1)
        var pages = [page]
        for p in below.flat_map(fn(ps) => ps)
          &pages.push(p)
        pages

// the urls of the pages found from `root`, three links deep, sorted
pub fn crawl_site(root: Str) -> Array<Str> uses Web, Async =
  with seen_set(), sync.semaphore(16), sync.limit() over Web in
    crawl(root, 3).map(fn(p) => p.url).sort()

// ---- tests ----

// how many requests are in flight, and the most there have been
pub dep Gauge =
  enter: fn()
  leave: fn()
  most: fn() -> Int

test handler gauge() for Gauge =
  var now = 0
  var top = 0
  enter() =>
    now += 1
    if now > top then top = now
  leave() => now -= 1
  most() => top

// a web of `site`'s pages, each taking 10 ms to fetch. It keeps no
// state, so its calls overlap: what's in flight is `Gauge`'s
test handler pages(site: Array<Page>) for Web uses Gauge, Clock =
  get(url) =>
    Gauge.enter()
    Clock.sleep(Duration.ms(10))
    Gauge.leave()
    match site.find(fn(p) => p.url == url)
      Some(p) => p
      None => fail Unreachable(url)

test fn page(url: Str, links: Array<Str>) -> Page = Page { url: url, links: links }

test "each page is found once, three links deep" =
  // `c` is below both `a` and `b`, and `d` is too deep
  let site = [page("/", ["a", "b"]), page("a", ["c"]), page("b", ["c", "/"]), page("c", ["d"]), page("d", [])]
  with gauge(), pages(site) in
    assert crawl_site("/") == ["/", "a", "b", "c"]

test "a page that can't be fetched is skipped" =
  let site = [page("/", ["a", "gone"]), page("a", [])]
  with gauge(), pages(site) in
    assert crawl_site("/") == ["/", "a"]

test "at most 16 requests at once" =
  var links: Array<Str> = []
  for i in 0..40
    &links.push(show(i))
  var site = [page("/", links)]
  for l in links
    &site.push(page(l, []))
  with gauge(), pages(site) in
    assert crawl_site("/").len() == 41
    assert Gauge.most() == 16
