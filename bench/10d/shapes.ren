// Stage 10d, step 3: handler descriptions as the only stored code
// (foundations.md, decision 3; compiler.md, "Stage 10d"). Stateless
// handlers called as methods, inline handlers that copy what they
// capture, descriptions kept in arrays and records, and a stored
// description's `uses` as an upper bound. Its codecs are kinds a
// library keeps and its users add to; the shapes it once had are an ADT
// now, in bench/data/shapes.ren (language.md §6).

// what each codec costs a block
dep Codec =
  cost: fn() -> Float

handler deflate(level: Float) for Codec =
  cost() => 3.0 * level * level

handler lz4(block: Float) for Codec =
  cost() => block * block

handler zstd(level: Float, window: Float) for Codec =
  cost() => level * window

fn total(codecs: Array<Codec>) -> Float =
  var t = 0.0
  for c in codecs
    t = t + c.cost()
  t

// an inline handler for a dependency of one operation: what it reads
// from here, `k`, is copied in when it's made
fn tuned(k: Float) -> Codec = handler fn() => k * k * 2.0

dep Price =
  of: fn(item: Str) -> Int

handler flat(cents: Int) for Price =
  of(_) => cents

// one that needs `Clock`: its description says so, and whoever calls it
// gives it one
handler surge(cents: Int) for Price uses Clock =
  of(_) => if Clock.now() == Time.epoch then cents * 2 else cents

type Offer = { name: Str, price: Price uses Clock }

fn quote(offers: Array<Offer>, item: Str) -> Int uses Clock =
  var sum = 0
  for o in offers
    sum += o.price.of(item)
  sum

fn main() uses Console =
  let codecs: Array<Codec> = [deflate(1.0), lz4(2.0), zstd(2.0, 3.0), tuned(1.5)]
  for c in codecs
    print(c.cost())
  print(total(codecs))
  // capture by copy: the handler keeps `n` as it was when it was made
  var n = 1
  let get: Codec = handler fn() => Float.of(n)
  n = 5
  print(get.cost())
  // the slot's `uses` is the most a price may need: `flat` needs nothing
  // and fits beside `surge`
  let offers = [
    Offer { name: "tea", price: flat(300) },
    Offer { name: "cake", price: surge(450) },
    Offer { name: "jam", price: handler fn(item) => item.len() * 100 },
  ]
  with Clock.frozen(Time.epoch) in
    print(quote(offers, "x"))
  with Clock.frozen(Time.epoch + Duration.ms(1)) in
    print(quote(offers, "xy"))
