gen fn numbers(n: Int) -> Int =
  for i in 0..n
    yield i

gen fn dedup(src: fn() -> Option<Int>) -> Int =
  var last: Option<Int> = None
  for x in src
    if Some(x) != last then
      last = Some(x)
      yield x

fn consume(src: fn() -> Option<Int>) -> Int =
  var sum = 0
  for x in src
    sum += x
  sum

fn main() uses Console =
  print(numbers(10)
    .map(fn(x) => x * 2)
    .select(fn(x) => x % 4 == 0)
    .take(3)
    .sum())
  print(numbers(3).zip(numbers(2)).to_array())
  print(dedup([1, 1, 2, 2, 3].cursor()).to_array())
  print(consume(numbers(4).map(fn(x) => x + 1)))
  var r = numbers(5)
  let p = &r.take(2)
  print(p())
  print(&r.next())
  print(p())
  print(&r.next())
