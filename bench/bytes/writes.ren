// Layer 3's writes at an offset (compiler.md, "Bytes stage"): each width
// and byte order, read back; `Bytes` are values, so writing one leaves
// every other value as it was: a copy, a slice, and the bytes of a
// literal.

fn main() uses Console =
  var b = Bytes.zeros(24)
  print(b)
  &b.set_u8(0, 0xAB)
  &b.set_i8(1, -2)
  &b.set_u16_le(2, 0x1234)
  &b.set_u16_be(4, 0x1234)
  &b.set_i16_le(6, -300)
  &b.set_u32_be(8, 0xDEAD_BEEF)
  &b.set_i32_le(12, -5)
  &b.set_u64_le(16, 0x0102_0304_0506_0708)
  print(b)
  print(b.i8(1))
  print(b.i16_le(6))
  print(b.u32_be(8))
  print(b.i32_le(12))
  print(b.u64_le(16))
  &b.set_i64_be(16, -2)
  print(b.i64_be(16))
  &b.set_u64_be(16, 9_223_372_036_854_775_807)
  print(b.u64_be(16))
  &b.set_u32_le(20, 4_294_967_295)
  print(b.u32_le(20))

  // a copy, a slice and a literal's bytes stay as they were
  let copy = b
  &b.set_u8(0, 1)
  print(copy.u8(0))
  print(b.u8(0))
  var part = b[8..12]
  &part.set_u8(0, 0)
  print(part)
  print(b.u32_be(8))
  var lit = "abc".bytes()
  &lit.set_u8(0, 65)
  print(attempt Str.from_utf8(lit))
  print("abc".bytes().u8(0))
