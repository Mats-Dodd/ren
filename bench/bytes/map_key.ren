// A key with a `key` (operators.md, "`key`"), natively: equal by its key,
// hashed by it, and a map keeps the first of equal keys, with the last
// value set.

pub type Email = opaque Str
  pub fn of(s: Str) -> Email = s
  pub fn key(self) -> Str = self.ascii_lower()
  pub fn text(self) -> Str = self

fn main() uses Console =
  var m: Map<Email, Int> = Map.empty
  &m.set(Email.of("Ann@Example.com"), 1)
  &m.set(Email.of("bob@example.com"), 2)
  &m.set(Email.of("ann@example.com"), 3)
  print(m.len())
  for (e, n) in m
    print(e.text() + " " + show(n))
  print(m.get(Email.of("ANN@EXAMPLE.COM")))
  &m.remove(Email.of("BOB@example.com"))
  print(m.len())
  let s = Set.of([Email.of("X@y"), Email.of("x@Y"), Email.of("z@y")])
  print(s.len())
  print(s.includes(Email.of("Z@Y")))
