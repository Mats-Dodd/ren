// 10,000 slices kept in an array of small records (compiler.md, "Bytes
// stage, part two", step 4): under representation B a slice is a value,
// so a release build makes a few objects here, its string's and its
// arrays' buffers, not one a slice. bench/strs.t counts them.

type Tok = { text: Str, at: Int }

fn main() uses Console =
  let digits = ["0", "1", "2", "3", "4", "5", "6"]
  var text = ""
  for i in 0..10_000
    text += "w"
    text += digits[i % 7]
    text += " "
  var toks: Array<Tok> = []
  var at = 0
  for w in text.split(" ")
    if not w.is_empty() then &toks.push(Tok { text: w[1..w.byte_len()], at: at })
    at += w.byte_len() + 1
  var sum = 0
  for t in toks
    sum += t.text.bytes().u8(0) - '0'
  print(toks.len())
  print(sum)
  print(toks[9_999].at)
