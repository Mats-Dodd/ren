; `dune build @bench` times the benchmarks (run.sh). It isn't part of
; `dune runtest`: timings differ from one machine to the next.

(rule
 (alias bench)
 (deps
  run.sh
  (glob_files *.ren)
  (glob_files vm/*.ren)
  (glob_files %{project_root}/examples/vm/*.ren))
 (action
  (run sh %{dep:run.sh} %{bin:ren})))

; build.t builds every program here, and the examples, that the native
; slice compiles, under the sanitizers, and checks each prints what
; `ren run` does; then again with tcc, as a debug build is. It needs a C
; compiler, cc or $REN_CC, and tcc, on PATH or $REN_TCC (tools/tcc.sh).

(cram
 (applies_to build)
 (deps
  (env_var PATH)
  (env_var NIX_HARDENING_ENABLE)
  %{bin:ren}
  (env_var REN_TCC)
  (glob_files *.ren)
  (glob_files native/binary-trees/*.ren)
  (glob_files native/blocks/*.ren)
  (glob_files native/bytes/*.ren)
  (glob_files native/cfold/*.ren)
  (glob_files native/deriv/*.ren)
  (glob_files native/fannkuch/*.ren)
  (glob_files native/frames/*.ren)
  (glob_files native/handlers/*.ren)
  (glob_files native/inout/*.ren)
  (glob_files native/maps/*.ren)
  (glob_files native/interp/*.ren)
  (glob_files native/nbody/*.ren)
  (glob_files native/nested/*.ren)
  (glob_files native/nqueens/*.ren)
  (glob_files native/rbtree/*.ren)
  (glob_files native/slices/*.ren)
  (glob_files native/stack/*.ren)
  (glob_files native/strs/*.ren)
  (glob_files native/vec/*.ren)
  (glob_files 10d/*.ren)
  (glob_files 10d/*.expected)
  (glob_files 11a/*.ren)
  (glob_files 11a/*.expected)
  (glob_files data/*.ren)
  (glob_files data/*.expected)
  (glob_files services/*.ren)
  (glob_files services/*.expected)
  services/refused.native
  services/wiring.explain
  (glob_files %{project_root}/examples/*.ren)
  (glob_files %{project_root}/examples/shop/*.ren)
  (glob_files %{project_root}/examples/shop/billing/*.ren)
  (glob_files %{project_root}/examples/two/*.ren)
  (glob_files %{project_root}/examples/checkout/*.ren)))

; tasks.t runs stage 11a's programs, in 11a/tasks/ until their steps
; land them in examples/, each `ren test` in its folder, and says which
; are as specified yet (compiler.md, "Stage 11a", "The tests"); and the
; services stage's milestone, examples/docs and its variants in services/
; ("Services stage").

(cram
 (applies_to tasks)
 (deps
  (env_var PATH)
  (env_var NIX_HARDENING_ENABLE)
  %{bin:ren}
  (glob_files %{project_root}/examples/crawler/*.ren)
  (glob_files %{project_root}/examples/just/*.ren)
  (glob_files %{project_root}/examples/just/tests/*.journal)
  (glob_files %{project_root}/examples/transfer/*.ren)
  (glob_files %{project_root}/examples/refresh/*.ren)
  (glob_files %{project_root}/examples/server/*.ren)
  (glob_files %{project_root}/examples/breaker/*.ren)
  (glob_files %{project_root}/examples/docs/*.ren)
  (glob_files 11a/tasks/lost_update/*.ren)
  (glob_files 11a/tasks/journal/*.ren)
  %{project_root}/examples/crawler/expected
  %{project_root}/examples/just/expected
  %{project_root}/examples/transfer/expected
  %{project_root}/examples/refresh/expected
  %{project_root}/examples/server/expected
  %{project_root}/examples/breaker/expected
  %{project_root}/examples/docs/expected
  11a/tasks/journal/v1.journal
  11a/tasks/journal/v1.expected
  (glob_files services/lost_update/*.ren)
  (glob_files services/memory/*.ren)
  (glob_files services/breaker_held/*.ren)))

; bytes.t runs the bytes stage's programs, in bytes/, through `ren run`
; and, once each step lands them, `ren build` under the sanitizers, and
; says which are as specified yet (compiler.md, "Bytes stage", "The
; tests"). It needs cc and tcc, as build.t does.

(cram
 (applies_to bytes)
 (deps
  (env_var PATH)
  (env_var NIX_HARDENING_ENABLE)
  %{bin:ren}
  (env_var REN_TCC)
  (glob_files bytes/*.ren)
  (glob_files bytes/*.expected)))

; strs.t runs the bytes stage part two's programs, in strs/, as bytes.t
; runs bytes/ (compiler.md, "Bytes stage, part two", "The tests"); it
; needs cc and tcc, as build.t does. strs_big.t runs the 4 GiB escape,
; which needs 8 GiB, only with REN_BIG_TESTS=1.

(cram
 (applies_to strs)
 (deps
  (env_var PATH)
  (env_var NIX_HARDENING_ENABLE)
  %{bin:ren}
  (env_var REN_TCC)
  (glob_files strs/*.ren)
  (glob_files strs/*.expected)))

; strs_lent.t, step 4's lent reads (part two), and strs_maps.t, its maps of
; strings (part three), as strs.t checks its programs.

(cram
 (applies_to strs_lent strs_maps)
 (deps
  %{bin:ren}
  (env_var REN_TCC)
  (glob_files strs/*.ren)
  (glob_files strs/*.expected)))

(cram
 (applies_to strs_big)
 (enabled_if
  (= %{env:REN_BIG_TESTS=0} 1))
 (deps
  (env_var PATH)
  (env_var NIX_HARDENING_ENABLE)
  %{bin:ren}
  (env_var REN_TCC)
  (glob_files strs/*.ren)
  (glob_files strs/*.expected)))

; patterns.t runs the patterns stage's programs, in patterns/, through
; `ren run` and, once each step lands them, natively, and says which are
; as specified yet, and which string `match`es are hashed (compiler.md,
; "Patterns stage", "The tests"). It needs cc and tcc, as build.t does.

(cram
 (applies_to patterns)
 (deps
  (env_var PATH)
  (env_var NIX_HARDENING_ENABLE)
  %{bin:ren}
  (env_var REN_TCC)
  (glob_files patterns/*.ren)
  (glob_files patterns/*.expected)
  (glob_files native/keywords/*.ren)))

; The generators stage's differential cases start as explicit targets,
; then run in each build as g1 through g5 land.

(cram
 (applies_to generators)
 (deps
  (env_var PATH)
  (env_var NIX_HARDENING_ENABLE)
  %{bin:ren}
  (env_var REN_TCC)
  (glob_files generators/*.ren)
  (glob_files generators/*.expected)
  (glob_files generators/*.sh)
  (glob_files generators/*.pending)
  generators/stages))
