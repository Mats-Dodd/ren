// Binary trees, from the Benchmarks Game (binarytrees, as Koka's
// test/bench/koka/binarytrees.kk runs it, on one thread): many perfect
// trees made and dropped at each depth, while one long-lived tree stays.
// It measures allocating and freeing small nodes.

type Tree =
  | Node { left: Tree, right: Tree }
  | Tip

// a perfect tree `depth` deep
fn make(depth: Int) -> Tree =
  if depth > 0 then Node { left: make(depth - 1), right: make(depth - 1) }
  else Node { left: Tip, right: Tip }

// how many nodes it has
fn check(t: Tree) -> Int =
  match t
    Node { left, right } => check(left) + check(right) + 1
    Tip => 0

fn pow2(k: Int) -> Int =
  var p = 1
  for _ in 0..k
    p *= 2
  p

fn show_depth(what: Str, depth: Int, check: Int) uses Console =
  Console.write(what.concat(" of depth ").concat(show(depth)).concat("\t check: ").concat(show(check)))

pub fn run(n: Int) uses Console =
  let min_depth = 4
  let max_depth = if n > min_depth + 2 then n else min_depth + 2
  let stretch = max_depth + 1
  show_depth("stretch tree", stretch, check(make(stretch)))
  let long = make(max_depth)
  var depth = min_depth
  while depth <= max_depth
    let iterations = pow2(max_depth - depth + min_depth)
    var total = 0
    for _ in 0..iterations
      total += check(make(depth))
    show_depth(show(iterations).concat("\t trees"), depth, total)
    depth += 2
  show_depth("long lived tree", max_depth, check(long))
