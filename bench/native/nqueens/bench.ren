// Every way to put n queens on an n by n board, from Koka's benchmarks
// (test/bench/koka/nqueens.kk). Solutions are lists that share their
// tails, so most of the work is making short-lived cells and counting
// shared ones. The checksum is how many solutions there are.

type List<T> =
  | Cons(head: T, tail: List<T>)
  | Nil

// how many elements `xs` has, after the `n` already counted
fn length<T>(xs: List<T>, n: Int) -> Int =
  match xs
    Cons(_, tail) => length(tail, n + 1)
    Nil => n

// whether a queen in this column, at row `queen`, is safe from the ones
// in `xs`, the nearest first, `diag` columns away
fn safe(queen: Int, diag: Int, xs: List<Int>) -> Bool =
  match xs
    Cons(q, qs) => queen != q && queen != q + diag && queen != q - diag && safe(queen, diag + 1, qs)
    Nil => true

// `xss`, with each safe row from `queen` down to 1 added to `xs`
fn append_safe(queen: Int, xs: List<Int>, xss: List<List<Int>>) -> List<List<Int>> =
  if queen <= 0 then xss
  else if safe(queen, 1, xs) then append_safe(queen - 1, xs, Cons(Cons(queen, xs), xss))
  else append_safe(queen - 1, xs, xss)

fn extend(queen: Int, acc: List<List<Int>>, xss: List<List<Int>>) -> List<List<Int>> =
  match xss
    Cons(xs, rest) => extend(queen, append_safe(queen, xs, acc), rest)
    Nil => acc

fn find_solutions(n: Int, queen: Int) -> List<List<Int>> =
  if queen == 0 then Cons(Nil, Nil)
  else extend(n, Nil, find_solutions(n, queen - 1))

pub fn run(n: Int) uses Console = print(length(find_solutions(n, n), 0))
