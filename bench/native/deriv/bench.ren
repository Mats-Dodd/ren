// Symbolic differentiation, from Koka's benchmarks
// (test/bench/koka/deriv.kk, after Lean's deriv.ml): the expression
// x^x differentiated n times, simplifying as it goes, with the size of
// each derivative printed. The terms share their parts, so it's counts,
// not copies, that keep them alive.

type Expr =
  | Val(value: Int)
  | Var(name: Str)
  | Add { l: Expr, r: Expr }
  | Mul { l: Expr, r: Expr }
  | Pow { l: Expr, r: Expr }
  | Ln(e: Expr)

// `a` to the power `b`, by squaring; a negative `b` counts as 0 or 1, as
// in the C++ version
fn pown(a: Int, b: Int) -> Int =
  if b == 0 then 1
  else if b == 1 then a
  else
    let y = pown(a, b / 2)
    y * y * (if b % 2 == 0 then 1 else a)

fn add(n0: Expr, m0: Expr) -> Expr =
  match (n0, m0)
    (Val(n), Val(m)) => Val(n + m)
    (Val(0), f) => f
    (f, Val(0)) => f
    (f, Val(n)) => add(Val(n), f)
    (Val(n), Add { l: Val(m), r: f }) => add(Val(n + m), f)
    (f, Add { l: Val(n), r: g }) => add(Val(n), add(f, g))
    (Add { l: f, r: g }, h) => add(f, add(g, h))
    (f, g) => Add { l: f, r: g }

fn mul(n0: Expr, m0: Expr) -> Expr =
  match (n0, m0)
    (Val(n), Val(m)) => Val(n * m)
    (Val(0), _) => Val(0)
    (_, Val(0)) => Val(0)
    (Val(1), f) => f
    (f, Val(1)) => f
    (f, Val(n)) => mul(Val(n), f)
    (Val(n), Mul { l: Val(m), r: f }) => mul(Val(n * m), f)
    (f, Mul { l: Val(n), r: g }) => mul(Val(n), mul(f, g))
    (Mul { l: f, r: g }, h) => mul(f, mul(g, h))
    (f, g) => Mul { l: f, r: g }

fn powr(m0: Expr, n0: Expr) -> Expr =
  match (m0, n0)
    (Val(m), Val(n)) => Val(pown(m, n))
    (_, Val(0)) => Val(1)
    (f, Val(1)) => f
    (Val(0), _) => Val(0)
    (f, g) => Pow { l: f, r: g }

fn ln(n: Expr) -> Expr =
  match n
    Val(1) => Val(0)
    f => Ln(f)

// the derivative of `e` by `x`
fn d(x: Str, e: Expr) -> Expr =
  match e
    Val(_) => Val(0)
    Var(y) => if x == y then Val(1) else Val(0)
    Add { l: f, r: g } => add(d(x, f), d(x, g))
    Mul { l: f, r: g } => add(mul(f, d(x, g)), mul(g, d(x, f)))
    Pow { l: f, r: g } =>
      mul(powr(f, g), add(mul(mul(g, d(x, f)), powr(f, Val(-1))), mul(ln(f), d(x, g))))
    Ln(f) => mul(d(x, f), powr(f, Val(-1)))

// how many leaves `e` has
fn count(e: Expr) -> Int =
  match e
    Val(_) => 1
    Var(_) => 1
    Add { l: f, r: g } => count(f) + count(g)
    Mul { l: f, r: g } => count(f) + count(g)
    Pow { l: f, r: g } => count(f) + count(g)
    Ln(f) => count(f)

pub fn run(n: Int) uses Console =
  var e = powr(Var("x"), Var("x"))
  for i in 0..n
    e = d("x", e)
    Console.write(show(i + 1) + " count: " + show(count(e)))
  Console.write("done")
