// [rounds] rounds of [n] queries of [set], by the chain or the match:
// the sum of each answer plus one, which the twins print too
pub fn run(set: Str, hashed: Bool, n: Int, rounds: Int) uses Console =
  let qs = queries(keys(set), n)
  var t = 0
  if set == "renkw" then t = if hashed then rounds_renkw_match(qs, rounds) else rounds_renkw_chain(qs, rounds)
  else if set == "jsreserved" then t = if hashed then rounds_jsreserved_match(qs, rounds) else rounds_jsreserved_chain(qs, rounds)
  else if set == "methods" then t = if hashed then rounds_methods_match(qs, rounds) else rounds_methods_chain(qs, rounds)
  else if set == "headers" then t = if hashed then rounds_headers_match(qs, rounds) else rounds_headers_chain(qs, rounds)
  else if set == "json24" then t = if hashed then rounds_json24_match(qs, rounds) else rounds_json24_chain(qs, rounds)
  else if set == "one" then t = if hashed then rounds_one_match(qs, rounds) else rounds_one_chain(qs, rounds)
  print(t)

// the same, by `keys.index(s)` on the set's keys, a literal bound by a
// `let`, which a release build hashes too
pub fn run_index(set: Str, n: Int, rounds: Int) uses Console =
  let qs = queries(keys(set), n)
  var t = 0
  if set == "renkw" then t = rounds_renkw_index(qs, rounds)
  else if set == "jsreserved" then t = rounds_jsreserved_index(qs, rounds)
  else if set == "methods" then t = rounds_methods_index(qs, rounds)
  else if set == "headers" then t = rounds_headers_index(qs, rounds)
  else if set == "json24" then t = rounds_json24_index(qs, rounds)
  else if set == "one" then t = rounds_one_index(qs, rounds)
  print(t)

// every set, both forms, which must agree with each other
pub fn check(n: Int) uses Console =
  for set in ["renkw", "jsreserved", "methods", "headers", "json24", "one"]
    let qs = queries(keys(set), n)
    var a = 0
    var b = 0
    for q in qs
      a += classify(set, false, q) + 1
      b += classify(set, true, q) + 1
    print(set + " " + show(a) + " " + show(b))
  for set in ["renkw", "jsreserved", "methods", "headers", "json24", "one"]
    run_index(set, n, 1)
