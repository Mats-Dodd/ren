// The patterns stage's keyword kernel (compiler.md, "Patterns stage";
// bench/native/RESULTS.md): identifiers classified against a key set,
// Ren's 35 keywords, JS's 45 reserved words, the 9 HTTP methods, 20
// header names and 24 JSON field names (research/perfect-hash/code/keys),
// 65,536 queries a round, 90% keys and 10% near misses. Each set's
// classifier is written as the `==` chain Ren had before string
// patterns, and as a `match` over literal arms, which compiles to a
// perfect hash. Generated by gen.py; rust/ and go/ are its twins.

fn renkw_chain(s: Str) -> Int =
  if s == "fn" then 0
  else if s == "pub" then 1
  else if s == "let" then 2
  else if s == "var" then 3
  else if s == "inout" then 4
  else if s == "for" then 5
  else if s == "while" then 6
  else if s == "break" then 7
  else if s == "todo" then 8
  else if s == "in" then 9
  else if s == "if" then 10
  else if s == "then" then 11
  else if s == "else" then 12
  else if s == "true" then 13
  else if s == "false" then 14
  else if s == "type" then 15
  else if s == "dep" then 16
  else if s == "match" then 17
  else if s == "import" then 18
  else if s == "as" then 19
  else if s == "uses" then 20
  else if s == "opaque" then 21
  else if s == "self" then 22
  else if s == "not" then 23
  else if s == "fail" then 24
  else if s == "try" then 25
  else if s == "attempt" then 26
  else if s == "orelse" then 27
  else if s == "with" then 28
  else if s == "handler" then 29
  else if s == "over" then 30
  else if s == "finally" then 31
  else if s == "test" then 32
  else if s == "group" then 33
  else if s == "assert" then 34
  else -1

