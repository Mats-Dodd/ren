  else if s == "break" then 1
  else if s == "case" then 2
  else if s == "catch" then 3
  else if s == "class" then 4
  else if s == "const" then 5
  else if s == "continue" then 6
  else if s == "debugger" then 7
  else if s == "default" then 8
  else if s == "delete" then 9
  else if s == "do" then 10
  else if s == "else" then 11
  else if s == "enum" then 12
  else if s == "export" then 13
  else if s == "extends" then 14
  else if s == "false" then 15
  else if s == "finally" then 16
  else if s == "for" then 17
  else if s == "function" then 18
  else if s == "if" then 19
  else if s == "import" then 20
  else if s == "in" then 21
  else if s == "instanceof" then 22
  else if s == "new" then 23
  else if s == "null" then 24
  else if s == "return" then 25
  else if s == "super" then 26
  else if s == "switch" then 27
  else if s == "this" then 28
  else if s == "throw" then 29
  else if s == "true" then 30
  else if s == "try" then 31
  else if s == "typeof" then 32
  else if s == "var" then 33
  else if s == "void" then 34
  else if s == "while" then 35
  else if s == "with" then 36
  else if s == "yield" then 37
  else if s == "implements" then 38
  else if s == "interface" then 39
  else if s == "package" then 40
  else if s == "private" then 41
  else if s == "protected" then 42
  else if s == "public" then 43
  else if s == "static" then 44
  else -1

fn methods_chain(s: Str) -> Int =
  if s == "GET" then 0
  else if s == "HEAD" then 1
  else if s == "POST" then 2
  else if s == "PUT" then 3
  else if s == "DELETE" then 4
  else if s == "CONNECT" then 5
  else if s == "OPTIONS" then 6
  else if s == "TRACE" then 7
  else if s == "PATCH" then 8
  else -1

fn headers_chain(s: Str) -> Int =
  if s == "Accept" then 0
  else if s == "Accept-Encoding" then 1
  else if s == "Authorization" then 2
  else if s == "Cache-Control" then 3
  else if s == "Connection" then 4
  else if s == "Content-Length" then 5
  else if s == "Content-Type" then 6
  else if s == "Cookie" then 7
  else if s == "Date" then 8
  else if s == "Host" then 9
  else if s == "If-None-Match" then 10
  else if s == "Location" then 11
  else if s == "Origin" then 12
  else if s == "Referer" then 13
  else if s == "Server" then 14
  else if s == "Set-Cookie" then 15
  else if s == "User-Agent" then 16
  else if s == "Vary" then 17
  else if s == "Via" then 18
  else if s == "X-Forwarded-For" then 19
  else -1

fn json24_chain(s: Str) -> Int =
  if s == "id" then 0
  else if s == "name" then 1
  else if s == "email" then 2
  else if s == "created_at" then 3
  else if s == "updated_at" then 4
  else if s == "deleted_at" then 5
  else if s == "status" then 6
  else if s == "owner_id" then 7
  else if s == "org_id" then 8
  else if s == "tags" then 9
  else if s == "title" then 10
  else if s == "description" then 11
  else if s == "priority" then 12
  else if s == "due_date" then 13
  else if s == "assignee_id" then 14
  else if s == "labels" then 15
  else if s == "version" then 16
  else if s == "etag" then 17
  else if s == "parent_id" then 18
  else if s == "metadata" then 19
  else if s == "visibility" then 20
  else if s == "archived" then 21
  else if s == "last_modified_by" then 22
  else if s == "notification_settings" then 23
  else -1

// the next number of the LCG every twin shares
fn next(x: Int) -> Int = (x * 1103515245 + 12345) % 2147483648

// [n] queries of [keys]: one in ten a near miss
fn queries(keys: Array<Str>, n: Int) -> Array<Str> =
  var qs: Array<Str> = []
  var x = 42
  for _ in 0..n
    x = next(x)
    let k = keys[x % keys.len()]
    x = next(x)
    if x % 10 != 0 then &qs.push(k)
    else if x / 10 % 2 == 0 then &qs.push(k + "_")
    else &qs.push(k[0..k.byte_len() - 1] + "#")
  qs

fn keys(set: Str) -> Array<Str> =
  if set == "renkw" then ["fn", "pub", "let", "var", "inout", "for", "while", "break", "todo", "in", "if", "then", "else", "true", "false", "type", "dep", "match", "import", "as", "uses", "opaque", "self", "not", "fail", "try", "attempt", "orelse", "with", "handler", "over", "finally", "test", "group", "assert"]
  else if set == "jsreserved" then ["await", "break", "case", "catch", "class", "const", "continue", "debugger", "default", "delete", "do", "else", "enum", "export", "extends", "false", "finally", "for", "function", "if", "import", "in", "instanceof", "new", "null", "return", "super", "switch", "this", "throw", "true", "try", "typeof", "var", "void", "while", "with", "yield", "implements", "interface", "package", "private", "protected", "public", "static"]
  else if set == "methods" then ["GET", "HEAD", "POST", "PUT", "DELETE", "CONNECT", "OPTIONS", "TRACE", "PATCH"]
  else if set == "headers" then ["Accept", "Accept-Encoding", "Authorization", "Cache-Control", "Connection", "Content-Length", "Content-Type", "Cookie", "Date", "Host", "If-None-Match", "Location", "Origin", "Referer", "Server", "Set-Cookie", "User-Agent", "Vary", "Via", "X-Forwarded-For"]
  else if set == "json24" then ["id", "name", "email", "created_at", "updated_at", "deleted_at", "status", "owner_id", "org_id", "tags", "title", "description", "priority", "due_date", "assignee_id", "labels", "version", "etag", "parent_id", "metadata", "visibility", "archived", "last_modified_by", "notification_settings"]
  else []

fn classify(set: Str, hashed: Bool, s: Str) -> Int =
  if set == "renkw" then (if hashed then renkw_chain(s) else renkw_chain(s))
  else if set == "jsreserved" then (if hashed then jsreserved_chain(s) else jsreserved_chain(s))
  else if set == "methods" then (if hashed then methods_chain(s) else methods_chain(s))
  else if set == "headers" then (if hashed then headers_chain(s) else headers_chain(s))
  else if set == "json24" then (if hashed then json24_chain(s) else json24_chain(s))
  else -1

fn rounds_renkw_chain(qs: Array<Str>, rounds: Int) -> Int =
  var t = 0
  for _ in 0..rounds
    for q in qs
      t += renkw_chain(q) + 1
  t

fn rounds_jsreserved_chain(qs: Array<Str>, rounds: Int) -> Int =
  var t = 0
  for _ in 0..rounds
    for q in qs
      t += jsreserved_chain(q) + 1
  t

fn rounds_methods_chain(qs: Array<Str>, rounds: Int) -> Int =
  var t = 0
  for _ in 0..rounds
    for q in qs
      t += methods_chain(q) + 1
  t

fn rounds_headers_chain(qs: Array<Str>, rounds: Int) -> Int =
  var t = 0
  for _ in 0..rounds
    for q in qs
      t += headers_chain(q) + 1
  t

fn rounds_json24_chain(qs: Array<Str>, rounds: Int) -> Int =
  var t = 0
  for _ in 0..rounds
    for q in qs
      t += json24_chain(q) + 1
  t

// [rounds] rounds of [n] queries of [set], by the chain or the match:
// the sum of each answer plus one, which the twins print too
pub fn run(set: Str, hashed: Bool, n: Int, rounds: Int) uses Console =
  let qs = queries(keys(set), n)
  var t = 0
  if set == "renkw" then t = if hashed then rounds_renkw_chain(qs, rounds) else rounds_renkw_chain(qs, rounds)
  else if set == "jsreserved" then t = if hashed then rounds_jsreserved_chain(qs, rounds) else rounds_jsreserved_chain(qs, rounds)
  else if set == "methods" then t = if hashed then rounds_methods_chain(qs, rounds) else rounds_methods_chain(qs, rounds)
  else if set == "headers" then t = if hashed then rounds_headers_chain(qs, rounds) else rounds_headers_chain(qs, rounds)
  else if set == "json24" then t = if hashed then rounds_json24_chain(qs, rounds) else rounds_json24_chain(qs, rounds)
  print(t)

// every set, both forms, which must agree with each other
pub fn check(n: Int) uses Console =
  for set in ["renkw", "jsreserved", "methods", "headers", "json24"]
    let qs = queries(keys(set), n)
    var a = 0
    var b = 0
    for q in qs
      a += classify(set, false, q) + 1
      b += classify(set, true, q) + 1
    print(set + " " + show(a) + " " + show(b))
