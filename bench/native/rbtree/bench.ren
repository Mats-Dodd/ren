// A red-black tree, built by inserting n keys, from Koka's benchmarks
// (test/bench/koka/rbtree.kk, after Lean's rbmap). Every insert makes a
// new tree from the old one, which nothing else holds: Perceus can reuse
// each node in place. The checksum is how many keys have a true value,
// one in ten.

type Color =
  | Red
  | Black

type Tree =
  | Node { color: Color, left: Tree, key: Int, value: Bool, right: Tree }
  | Leaf

fn is_red(t: Tree) -> Bool =
  match t
    Node { color: Red, .. } => true
    _ => false

fn balance_left(l: Tree, k: Int, v: Bool, r: Tree) -> Tree =
  match l
    Node {
      left: Node { color: Red, left: lx, key: kx, value: vx, right: rx },
      key: ky,
      value: vy,
      right: ry,
      ..
    } =>
      Node {
        color: Red,
        left: Node { color: Black, left: lx, key: kx, value: vx, right: rx },
        key: ky,
        value: vy,
        right: Node { color: Black, left: ry, key: k, value: v, right: r },
      }
    Node {
      left: ly,
      key: ky,
      value: vy,
      right: Node { color: Red, left: lx, key: kx, value: vx, right: rx },
      ..
    } =>
      Node {
        color: Red,
        left: Node { color: Black, left: ly, key: ky, value: vy, right: lx },
        key: kx,
        value: vx,
        right: Node { color: Black, left: rx, key: k, value: v, right: r },
      }
    Node { left, key, value, right, .. } =>
      Node {
        color: Black,
        left: Node { color: Red, left, key, value, right },
        key: k,
        value: v,
        right: r,
      }
    Leaf => Leaf

fn balance_right(l: Tree, k: Int, v: Bool, r: Tree) -> Tree =
  match r
    Node {
      left: Node { color: Red, left: lx, key: kx, value: vx, right: rx },
      key: ky,
      value: vy,
      right: ry,
      ..
    } =>
      Node {
        color: Red,
        left: Node { color: Black, left: l, key: k, value: v, right: lx },
        key: kx,
        value: vx,
        right: Node { color: Black, left: rx, key: ky, value: vy, right: ry },
      }
    Node {
      left: lx,
      key: kx,
      value: vx,
      right: Node { color: Red, left: ly, key: ky, value: vy, right: ry },
      ..
    } =>
      Node {
        color: Red,
        left: Node { color: Black, left: l, key: k, value: v, right: lx },
        key: kx,
        value: vx,
        right: Node { color: Black, left: ly, key: ky, value: vy, right: ry },
      }
    Node { left, key, value, right, .. } =>
      Node {
        color: Black,
        left: l,
        key: k,
        value: v,
        right: Node { color: Red, left, key, value, right },
      }
    Leaf => Leaf

fn ins(t: Tree, k: Int, v: Bool) -> Tree =
  match t
    Node { color: Red, left, key, value, right } =>
      if k < key then Node { color: Red, left: ins(left, k, v), key, value, right }
      else if k > key then Node { color: Red, left, key, value, right: ins(right, k, v) }
      else Node { color: Red, left, key: k, value: v, right }
    Node { color: Black, left, key, value, right } =>
      if k < key then
        if is_red(left) then balance_left(ins(left, k, v), key, value, right)
        else Node { color: Black, left: ins(left, k, v), key, value, right }
      else if k > key then
        if is_red(right) then balance_right(left, key, value, ins(right, k, v))
        else Node { color: Black, left, key, value, right: ins(right, k, v) }
      else Node { color: Black, left, key: k, value: v, right }
    Leaf => Node { color: Red, left: Leaf, key: k, value: v, right: Leaf }

fn set_black(t: Tree) -> Tree =
  match t
    Node { left, key, value, right, .. } => Node { color: Black, left, key, value, right }
    _ => t

fn insert(t: Tree, k: Int, v: Bool) -> Tree = set_black(ins(t, k, v))

// every key and value, in order, through `f`, from `acc`
fn fold<A>(t: Tree, acc: A, f: fn(Int, Bool, A) -> A) -> A =
  match t
    Node { left, key, value, right, .. } => try fold(right, f(key, value, fold(left, acc, f)), f)
    Leaf => acc

// the keys n - 1 down to 0, each true if it's a multiple of 10
fn make_tree(n: Int) -> Tree =
  var t = Leaf
  var i = n
  while i > 0
    i -= 1
    t = insert(t, i, i % 10 == 0)
  t

pub fn run(n: Int) uses Console =
  let t = make_tree(n)
  print(fold(t, 0, fn(_, v, r) => if v then r + 1 else r))
