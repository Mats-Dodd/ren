  let c0_5 = seed % 97 + 36
  let c1_5 = seed % 89 + 70
  &routes.push(handler fn(req) =>
    let c0 = c0_5
    let c1 = c1_5
    (((req.xor(c1) * 13) + c0).shr(2).xor(c1) * 15))
  let c0_6 = seed % 97 + 43
  let c1_6 = seed % 89 + 83
  &routes.push(handler fn(req) =>
    let c0 = c0_6
    let c1 = c1_6
    (((req + c0).shr(2) + c1).shr(3).xor(c0) * 17))
  let c0_7 = seed % 97 + 50
  let c1_7 = seed % 89 + 96
  &routes.push(handler fn(req) =>
