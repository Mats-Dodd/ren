  let c0_3 = seed % 97 + 22
  let c1_3 = seed % 89 + 44
  &routes.push(handler fn(req) =>
    let c0 = c0_3
    let c1 = c1_3
    (((req - c1).xor(req.shr(1)).xor(c0) * 10).xor(c1) * 11))
  let c0_4 = seed % 97 + 29
  let c1_4 = seed % 89 + 57
  &routes.push(handler fn(req) =>
    let c0 = c0_4
    let c1 = c1_4
