// generated by gen.py: the dispatch benchmark (research/dispatch.md's
// kernels; foundations.md, decision 4). Each kernel calls an operation on
// descriptions chosen at run time, and prints a checksum its Rust and Go
// twins print too.

// the next number of a 64-bit LCG, and 31 bits of it
fn lcg(s: Int) -> Int = s *% 6364136223846793005 +% 1442695040888963407
fn bits(s: Int) -> Int = s.shr(33).bit_and(2147483647)

dep Shape2 =
  area: fn() -> Int

handler s2_0(a: Int) for Shape2 =
  area() => (((a * a + 1) * a + 2) * a + 3)
handler s2_1(a: Int, b: Int) for Shape2 =
  area() => (((a + b * 2) * a + 3) * b + 4)

fn shapes2(n: Int, rounds: Int) -> Int =
  var xs: Array<Shape2> = []
  var s = 2
  for _ in 0..n
    s = lcg(s)
    let r = bits(s)
    let kind = r % 2
    let a = r % 64 + 1
    let b = r.shr(6) % 64 + 1
    let c = r.shr(12) % 64 + 1
    let x: Shape2 =
      if kind == 0 then s2_0(a)
      else s2_1(a, b)
    &xs.push(x)
  var sum = 0
  for _ in 0..rounds
    for x in xs
      sum += x.area()
  sum

dep Shape4 =
  area: fn() -> Int

handler s4_0(a: Int) for Shape4 =
  area() => (((a * a + 1) * a + 2) * a + 3)
handler s4_1(a: Int, b: Int) for Shape4 =
  area() => (((a + b * 2) * a + 3) * b + 4)
handler s4_2(a: Int, b: Int, c: Int) for Shape4 =
  area() => (((a * 3 - 3) * c + 4) * a + 5)
handler s4_3(a: Int) for Shape4 =
  area() => ((((a + 4) * a) * a + 5) * a + 6)

fn shapes4(n: Int, rounds: Int) -> Int =
  var xs: Array<Shape4> = []
  var s = 4
  for _ in 0..n
    s = lcg(s)
    let r = bits(s)
    let kind = r % 4
    let a = r % 64 + 1
    let b = r.shr(6) % 64 + 1
    let c = r.shr(12) % 64 + 1
    let x: Shape4 =
      if kind == 0 then s4_0(a)
      else if kind == 1 then s4_1(a, b)
      else if kind == 2 then s4_2(a, b, c)
      else s4_3(a)
    &xs.push(x)
  var sum = 0
  for _ in 0..rounds
    for x in xs
      sum += x.area()
  sum

