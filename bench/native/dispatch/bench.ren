    let c1 = c1_39
    ((((req.bit_and(c1) + req.bit_or(81)) * 82) + c0) + c1).shr(2))
  let c0_40 = seed % 97 + 281
  let c1_40 = seed % 89 + 525
  &routes.push(handler fn(req) =>
    let c0 = c0_40
    let c1 = c1_40
    (((req.xor(c0) * 83) - c1).xor((req.xor(c0) * 83).shr(2)) + c0).shr(3))
  let c0_41 = seed % 97 + 288
  let c1_41 = seed % 89 + 538
  &routes.push(handler fn(req) =>
    let c0 = c0_41
    let c1 = c1_41
    (((req + c1).shr(2) - c0).xor((req + c1).shr(2).shr(2)) + c1).shr(4))
  let c0_42 = seed % 97 + 295
  let c1_42 = seed % 89 + 551
  &routes.push(handler fn(req) =>
    let c0 = c0_42
    let c1 = c1_42
    ((((req * 87) + c0) - c1).xor(((req * 87) + c0).shr(2)) + c0).shr(5))
  let c0_43 = seed % 97 + 302
  let c1_43 = seed % 89 + 564
  &routes.push(handler fn(req) =>
    let c0 = c0_43
    let c1 = c1_43
    (((req - c1).xor(req.shr(1)) - c0).xor((req - c1).xor(req.shr(1)).shr(2)) + c1).shr(1))
  let c0_44 = seed % 97 + 309
  let c1_44 = seed % 89 + 577
  &routes.push(handler fn(req) =>
    let c0 = c0_44
    let c1 = c1_44
    (((req.bit_and(c0) + req.bit_or(91)) - c1).xor((req.bit_and(c0) + req.bit_or(91)).shr(2)) + c0).shr(2))
  let c0_45 = seed % 97 + 316
  let c1_45 = seed % 89 + 590
  &routes.push(handler fn(req) =>
    let c0 = c0_45
    let c1 = c1_45
    (((req.xor(c1) * 93).bit_and(c0) + (req.xor(c1) * 93).bit_or(94)) + c1).shr(3))
  let c0_46 = seed % 97 + 323
  let c1_46 = seed % 89 + 603
  &routes.push(handler fn(req) =>
    let c0 = c0_46
    let c1 = c1_46
    (((req + c0).shr(2).bit_and(c1) + (req + c0).shr(2).bit_or(96)) + c0).shr(4))
  let c0_47 = seed % 97 + 330
  let c1_47 = seed % 89 + 616
  &routes.push(handler fn(req) =>
    let c0 = c0_47
    let c1 = c1_47
    ((((req * 97) + c1).bit_and(c0) + ((req * 97) + c1).bit_or(98)) + c1).shr(5))
  let c0_48 = seed % 97 + 337
  let c1_48 = seed % 89 + 629
  &routes.push(handler fn(req) =>
    let c0 = c0_48
    let c1 = c1_48
    (((req - c0).xor(req.shr(1)).bit_and(c1) + (req - c0).xor(req.shr(1)).bit_or(100)) + c0).shr(1))
  let c0_49 = seed % 97 + 344
  let c1_49 = seed % 89 + 642
  &routes.push(handler fn(req) =>
    let c0 = c0_49
    let c1 = c1_49
    (((req.bit_and(c1) + req.bit_or(101)).bit_and(c0) + (req.bit_and(c1) + req.bit_or(101)).bit_or(102)) + c1).shr(2))
  routes

fn router(n: Int, rounds: Int) -> Int =
  let routes = routes(rounds)
  var reqs: Array<Int> = []
  var which: Array<Int> = []
  var s = 50
  for _ in 0..n
    s = lcg(s)
    let r = bits(s)
    &which.push(r % 50)
    &reqs.push(r.shr(8).bit_and(1048575))
  var acc = 0
  for _ in 0..rounds
    for i, w in which
      acc += routes[w].handle(reqs[i]).bit_and(1023)
  acc

dep Node =
  eval: fn(env: Array<Int>) -> Int

handler lit(v: Int) for Node =
  eval(env) => v
handler slot(i: Int) for Node =
  eval(env) => env[i]
handler add(a: Node, b: Node) for Node =
  eval(env) => a.eval(env) + b.eval(env)
handler sub(a: Node, b: Node) for Node =
  eval(env) => a.eval(env) - b.eval(env)
handler lt(a: Node, b: Node) for Node =
  eval(env) => if a.eval(env) < b.eval(env) then 1 else 0
handler neg(a: Node) for Node =
  eval(env) => 0 - a.eval(env)
handler max(a: Node, b: Node) for Node =
  eval(env) =>
    let x = a.eval(env)
    let y = b.eval(env)
    if x > y then x else y
handler min(a: Node, b: Node) for Node =
  eval(env) =>
    let x = a.eval(env)
    let y = b.eval(env)
    if x < y then x else y

// the numbers a tree is built from
dep Rng =
  next: fn() -> Int

handler rng(seed: Int) for Rng =
  var s = seed
  next() =>
    s = lcg(s)
    bits(s)

fn tree(d: Int) -> Node uses Rng =
  let r = Rng.next()
  if d == 0 || r % 4 == 0 then
    let r2 = Rng.next()
    if r2 % 2 == 0 then lit(r2 / 2 % 100) else slot(r2 / 2 % 4)
  else
    let k = r.shr(8) % 6
    if k == 3 then neg(tree(d - 1))
    else
      let a = tree(d - 1)
      let b = tree(d - 1)
      if k == 0 then add(a, b)
      else if k == 1 then sub(a, b)
      else if k == 2 then lt(a, b)
      else if k == 4 then max(a, b)
      else min(a, b)

fn interp(evals: Int) -> Int =
  let t = with rng(1) in tree(17)
  var total = 0
  for e in 0..evals
    let env = [e, e * 3 + 1, e % 7, 100 - e]
    total += t.eval(env)
  total

pub fn run(rounds: Int) uses Console =
  let n = if rounds >= 100 then 65536 else 1000
  print(shapes2(n, rounds))
  print(shapes4(n, rounds))
  print(shapes8(n, rounds))
  print(shapes32(n, rounds))
  print(db(rounds, n * rounds * 16))
  print(router(n, rounds))
  print(interp(rounds * (n / 256)))
