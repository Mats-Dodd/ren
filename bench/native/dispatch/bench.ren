      else if kind == 1 then s8_1(a, b)
      else if kind == 2 then s8_2(a, b, c)
      else if kind == 3 then s8_3(a)
      else if kind == 4 then s8_4(a, b)
      else if kind == 5 then s8_5(a, b, c)
      else if kind == 6 then s8_6(a)
      else s8_7(a, b)
    &xs.push(x)
  var sum = 0
  for _ in 0..rounds
    for x in xs
      sum += x.area()
  sum

