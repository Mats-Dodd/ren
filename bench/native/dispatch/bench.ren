fn shapes32(n: Int, rounds: Int) -> Int =
  var xs: Array<Shape32> = []
  var s = 32
  for _ in 0..n
    s = lcg(s)
    let r = bits(s)
    let kind = r % 32
    let a = r % 64 + 1
    let b = r.shr(6) % 64 + 1
    let c = r.shr(12) % 64 + 1
    let x: Shape32 =
      if kind == 0 then s32_0(a)
      else if kind == 1 then s32_1(a, b)
      else if kind == 2 then s32_2(a, b, c)
      else if kind == 3 then s32_3(a)
      else if kind == 4 then s32_4(a, b)
      else if kind == 5 then s32_5(a, b, c)
      else if kind == 6 then s32_6(a)
      else if kind == 7 then s32_7(a, b)
      else if kind == 8 then s32_8(a, b, c)
      else if kind == 9 then s32_9(a)
      else if kind == 10 then s32_10(a, b)
      else if kind == 11 then s32_11(a, b, c)
      else if kind == 12 then s32_12(a)
      else if kind == 13 then s32_13(a, b)
      else if kind == 14 then s32_14(a, b, c)
      else if kind == 15 then s32_15(a)
      else if kind == 16 then s32_16(a, b)
      else if kind == 17 then s32_17(a, b, c)
      else if kind == 18 then s32_18(a)
      else if kind == 19 then s32_19(a, b)
      else if kind == 20 then s32_20(a, b, c)
      else if kind == 21 then s32_21(a)
      else if kind == 22 then s32_22(a, b)
      else if kind == 23 then s32_23(a, b, c)
      else if kind == 24 then s32_24(a)
      else if kind == 25 then s32_25(a, b)
      else if kind == 26 then s32_26(a, b, c)
      else if kind == 27 then s32_27(a)
      else if kind == 28 then s32_28(a, b)
      else if kind == 29 then s32_29(a, b, c)
      else if kind == 30 then s32_30(a)
      else s32_31(a, b)
    &xs.push(x)
  var sum = 0
  for _ in 0..rounds
    for x in xs
      sum += x.area()
  sum

dep Db =
  get: fn(k: Int) -> Int

handler db0(s0: Int, s1: Int) for Db =
  get(k) => ((k * s0 + 3) * s1 + 4)
handler db1(s0: Int, s1: Int) for Db =
  get(k) => ((k + s1 * 4) * s0 + 5)
handler db2(s0: Int, s1: Int) for Db =
  get(k) => ((k * 5 - s0) * s1 + 6)
handler db3(s0: Int, s1: Int) for Db =
  get(k) => (((k + 6) * s1) * s0 + 7)

// the handler is chosen from data: the description doesn't change in
// the loop, so its tag doesn't either
fn hot(db: Db, keys: Array<Int>, n: Int) -> Int =
  var acc = 0
  for i in 0..n
    acc += db.get(keys[i % 1024])
  acc

fn pick(seed: Int) -> Int =
  var s = seed
  for _ in 0..1000
    s = lcg(s)
  bits(s)

fn db(rounds: Int, calls: Int) -> Int =
  let dbs: Array<Db> = [db0(2, 3), db1(3, 6), db2(4, 9), db3(5, 5)]
  var keys: Array<Int> = []
  for i in 0..1024
    &keys.push(i * 7919 % 1024)
  hot(dbs[pick(rounds) % 4], keys, calls)

dep Route =
  handle: fn(req: Int) -> Int

fn routes(seed: Int) -> Array<Route> =
  var routes: Array<Route> = []
  let c0_0 = seed % 97 + 1
  let c1_0 = seed % 89 + 5
  &routes.push(handler fn(req) =>
    let c0 = c0_0
    let c1 = c1_0
    (((req.xor(c0) * 3).xor(c1) * 4).xor(c0) * 5))
  let c0_1 = seed % 97 + 8
  let c1_1 = seed % 89 + 18
  &routes.push(handler fn(req) =>
    let c0 = c0_1
    let c1 = c1_1
    (((req + c1).shr(2).xor(c0) * 6).xor(c1) * 7))
  let c0_2 = seed % 97 + 15
