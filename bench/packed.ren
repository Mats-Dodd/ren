// An object's small scalars packed into shared words (to_mem.ml, [pack]),
// where they meet the rest: a red-black tree's color and value in one
// word, its nodes reused as Perceus takes them apart; a record of more
// than eight `Bool`s, two packed words; a record changed a field at a
// time; and each walked by `show`, `==` and a generic function, which
// find a packed field through its declaration (ren_rt.h,
// [ren_ctor_field]). build.t runs it under the sanitizers.

type Color =
  | Red
  | Black

type Tree =
  | Node { color: Color, left: Tree, key: Int, value: Bool, right: Tree }
  | Leaf

fn ins(t: Tree, k: Int, v: Bool) -> Tree =
  match t
    Node { color, left, key, value, right } =>
      if k < key then balance(Node { color, left: ins(left, k, v), key, value, right })
      else if k > key then balance(Node { color, left, key, value, right: ins(right, k, v) })
      else Node { color, left, key: k, value: v, right }
    Leaf => Node { color: Red, left: Leaf, key: k, value: v, right: Leaf }

fn balance(t: Tree) -> Tree =
  match t
    Node {
      color: Black,
      left: Node {
        color: Red,
        left: Node { color: Red, left: a, key: xk, value: xv, right: b },
        key: yk,
        value: yv,
        right: c,
      },
      key: zk,
      value: zv,
      right: d,
    } =>
      Node {
        color: Red,
        left: Node { color: Black, left: a, key: xk, value: xv, right: b },
        key: yk,
        value: yv,
        right: Node { color: Black, left: c, key: zk, value: zv, right: d },
      }
    Node {
      color: Black,
      left: a,
      key: xk,
      value: xv,
      right: Node {
        color: Red,
        left: b,
        key: yk,
        value: yv,
        right: Node { color: Red, left: c, key: zk, value: zv, right: d },
      },
    } =>
      Node {
        color: Red,
        left: Node { color: Black, left: a, key: xk, value: xv, right: b },
        key: yk,
        value: yv,
        right: Node { color: Black, left: c, key: zk, value: zv, right: d },
      }
    _ => t

fn blacken(t: Tree) -> Tree =
  match t
    Node { left, key, value, right, .. } => Node { color: Black, left, key, value, right }
    Leaf => Leaf

fn trues(t: Tree) -> Int =
  match t
    Node { left, value: true, right, .. } => trues(left) + trues(right) + 1
    Node { left, value: false, right, .. } => trues(left) + trues(right)
    Leaf => 0

fn reds(t: Tree) -> Int =
  match t
    Node { color: Red, left, right, .. } => reds(left) + reds(right) + 1
    Node { color: Black, left, right, .. } => reds(left) + reds(right)
    Leaf => 0

type Level =
  | Low
  | Mid
  | High

type Flags = {
  a: Bool, name: Str, b: Bool, c: Bool, d: Bool, level: Level,
  e: Bool, f: Bool, g: Bool, h: Bool, i: Bool, n: Int, last: Level
}

fn count_on(x: Flags) -> Int =
  var k = 0
  for on in [x.a, x.b, x.c, x.d, x.e, x.f, x.g, x.h, x.i]
    if on then k += 1
  k

fn first<T>(xs: Array<T>) -> T = xs[0]

fn main() uses Console =
  var t = Leaf
  for i in 0..40
    t = blacken(ins(t, (i * 7) % 41, i % 3 == 0))
  print(trues(t))
  print(reds(t))
  print(blacken(ins(ins(Leaf, 2, true), 1, false)))
  let x = Flags {
    a: true, name: "x", b: false, c: true, d: false, level: High,
    e: true, f: false, g: true, h: false, i: true, n: 42, last: Mid
  }
  print(x)
  print(count_on(x))
  var y = x
  y.b = true
  y.level = Low
  y.i = false
  print(y)
  print(count_on(y))
  print(x == y)
  var z = y
  z.b = false
  z.level = High
  z.i = true
  print(x == z)
  print(first([y, x]).level == Low)
  print(first([x]))
  print([Node { color: Red, left: Leaf, key: 1, value: true, right: Leaf }, Leaf])
