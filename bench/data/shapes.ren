// Data stage, step 6: bench/10d/shapes.ren's `Shape`, which modelled data
// with a dependency, as an ADT (language.md §6: if you own every kind,
// write the ADT). A generic total takes the operation as a block
// (language.md §3). Each native build against `ren run`.

type Shape =
  | Circle(r: Float)
  | Square(s: Float)
  | Rect { w: Float, h: Float }

  pub fn area(self) -> Float =
    match self
      Circle(r) => 3.0 * r * r
      Square(s) => s * s
      Rect { w, h } => w * h

fn total(shapes: Array<Shape>, area: fn(Shape) -> Float) -> Float =
  var t = 0.0
  for s in shapes
    t = t + try area(s)
  t

fn main() uses Console =
  let shapes = [Circle(1.0), Square(2.0), Rect { w: 2.0, h: 3.0 }]
  for s in shapes
    print(s.area())
  print(total(shapes, Shape.area))
  print(shapes[2])
  print(shapes[0] == Circle(1.0))
