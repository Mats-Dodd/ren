// Data stage, step 7: the third layout fix (compiler.md, "The layout
// fixes (step 7)"). A sum with one constructor that has fields, one of
// them an object, and any number without has no tag: the object's slot
// holds `ren_box(UINT32_MAX - t)` for constructor `t` without fields.
// Any other sum's tag is a byte, its constructors' small scalars packed
// beside it in slot 0. Nothing here is shown or compared whole, or kept
// in a record or another sum as a field, which would box its type
// (niche_walks.ren does those): what's printed is read out of the slots.
// Options of a `Str`, an array and a record, in arrays; sums of several
// constructors without fields and one with an object, its fields first
// or last, or alone; byte tags with `Bool`s and sized ints beside them;
// variant types of niche'd sums; each built, matched with or-patterns
// and `as`, updated, kept in `var`s and arrays, and through `inout` and
// a block; and the join of a constructor without fields and a
// parameter, which Mem Lint refused in debug builds.

type Item = { name: Str, price: Int }

// four constructors without fields around one with an object and an Int
type Plan =
  | Free
  | Trial
  | Pro { name: Str, seats: Int }
  | Lapsed
  | Banned

// the one with fields first
type Hold =
  | Held(s: Str)
  | Empty
  | Locked

// one object, flattened through a record
type Name = { s: Str }

type Who =
  | Named(n: Name)
  | Anon

// one constructor alone: no tag, nothing to tell apart
type Wrap =
  | Wrap { s: Str, n: Int, ok: Bool }

// byte tags with small scalars packed beside them
type Cell =
  | Wall(solid: Bool)
  | Floor { lit: Bool, depth: Int16, glyph: UInt8 }
  | Water(depth: Int)
  | Void

type Mark =
  | Dot(on: Bool)
  | Pin { on: Bool, label: Str }
  | Gone

fn plan(k: Int, names: Array<Str>) -> Plan =
  match k % 6
    0 => Free
    1 => Trial
    2 => Pro { name: names[k % 3], seats: k }
    3 => Lapsed
    4 => Banned
    _ => Pro { name: names[(k + 1) % 3] + "+", seats: 1 }

fn seats(p: Plan) -> Int =
  match p
    Free | Trial => 0
    Pro { seats, .. } => seats
    Lapsed | Banned => -1

// a variant type of a niche'd sum, stored and returned
fn pros_of(ps: Array<Plan>) -> Array<Plan.Pro> =
  var out: Array<Plan.Pro> = []
  for p in ps
    match p
      Pro { .. } as q => &out.push(q)
      _ => ()
  out

fn upgrade(q: Plan.Pro) -> Plan = Pro { ..q, seats: q.seats + 10 }

fn pick(c: Bool, p: Option<Str>) -> Option<Str> = if c then None else p

fn lapse(c: Bool, p: Plan) -> Plan = if c then Lapsed else p

fn cell(k: Int) -> Cell =
  match k % 4
    0 => Wall(k % 3 == 0)
    1 => Floor { lit: k % 2 == 1, depth: k * 7 - 300, glyph: k % 256 }
    2 => Water(k * 1000000007)
    _ => Void

fn depth(c: Cell) -> Int =
  match c
    Wall(s) => if s then 1 else 0
    Floor { lit, depth, glyph } as f => (if lit then depth else 0 - depth) + glyph + f.glyph
    Water(d) => d % 1000
    Void => 7

fn bump(inout ps: Array<Plan>) =
  var i = 0
  while i < ps.len()
    match ps[i]
      Pro { .. } as q => ps[i] = upgrade(q)
      Free => ps[i] = Trial
      _ => ()
    i += 1

fn first_name(os: Array<Option<Item>>) -> Str =
  var out = "none"
  for o in os
    match o
      Some(Item { name, .. }) if out == "none" => out = name
      _ => ()
  out

fn total(os: Array<Option<Item>>, f: fn(Item) -> Int) -> Int =
  var t = 0
  for o in os
    match o
      Some(i) => t += try f(i)
      None => ()
  t

fn main() uses Console =
  let names = ["tea", "jam", "cake"]
  // options of a `Str`, an array and a record, in arrays
  var strs: Array<Option<Str>> = []
  var arrs: Array<Option<Array<Int>>> = []
  var items: Array<Option<Item>> = []
  for k in 0..30
    &strs.push(if k % 3 == 0 then None else Some(names[k % 3] + "!"))
    &arrs.push(if k % 4 == 0 then Some([k, k + 1]) else None)
    &items.push(if k % 5 == 1 then Some(Item { name: names[k % 3], price: k }) else None)
  var n = 0
  for s in strs
    match s
      Some(x) => n += x.byte_len()
      None => n += 100
  print(n)
  var m = 0
  for a in arrs
    match a
      Some(xs) => m += xs[1]
      None => ()
  print(m)
  print(first_name(items))
  print(total(items, fn(i) => i.price * 2))
  // shared, then changed
  let kept = items
  items[1] = None
  items[0] = Some(Item { name: "fig" + "s", price: 1000 })
  print(total(kept, fn(i) => i.price))
  print(total(items, fn(i) => i.price))
  print(total(items[0..3], fn(i) => i.name.byte_len()))
  // several without fields and one with an object
  var plans: Array<Plan> = []
  for k in 0..12
    &plans.push(plan(k, names))
  var s = 0
  for p in plans
    s += seats(p)
  print(s)
  bump(&plans)
  var t = 0
  for p in plans
    t += seats(p)
    match p
      Trial | Free => t += 1000
      Pro { name, .. } => t += name.byte_len() * 100000
      Lapsed | Banned => ()
  print(t)
  // variant types, round-tripped
  let pros = pros_of(plans)
  print(pros.len())
  var q = pros[0]
  q.seats = 99
  match Pro { ..q, name: q.name + "?" }
    Pro { name, seats } => print(name.byte_len() * 1000 + seats)
    _ => print("?")
  match upgrade(pros[1])
    Pro { seats, .. } as up => print(seats + up.seats)
    _ => ()
  // the join of a constructor without fields and a parameter
  match pick(false, Some("kept" + "!"))
    Some(x) => print(x)
    None => print("none")
  match pick(true, Some("dropped" + "!"))
    Some(x) => print(x)
    None => print("none")
  print(seats(lapse(false, plans[2])))
  print(seats(lapse(true, plans[2])))
  // the one with fields first, and one object through a record
  var holds: Array<Hold> = [Empty, Held("a" + "b"), Locked]
  holds[0] = Held("c" + "d")
  var hl = 0
  for h in holds
    match h
      Held(x) => hl += x.byte_len()
      Empty => hl += 10
      Locked => hl += 100
  print(hl)
  let whos = [Named(Name { s: "ann" + "e" }), Anon]
  for w in whos
    match w
      Named(Name { s }) => print(s)
      Anon => print("anon")
  let w = Wrap { s: "w" + "w", n: 3, ok: true }
  match w
    Wrap { s, n, ok } => if ok then print(s.byte_len() + n) else print(0)
  // byte tags
  var cells: Array<Cell> = []
  for k in 0..16
    &cells.push(cell(k))
  var d = 0
  for c in cells
    d += depth(c)
  print(d)
  cells[1] = Floor { lit: true, depth: -32768, glyph: 255 }
  print(depth(cells[1]))
  // a variant type of a byte-tagged sum, its packed fields changed one at
  // a time, and the sum again
  match cells[5]
    Floor { .. } as f =>
      var g = f
      g.depth = g.depth + 1
      g.lit = not g.lit
      print(depth(Floor { ..g, glyph: 7 }))
      print(depth(Floor { ..g }))
    _ => print("?")
  var marks: Array<Mark> = [Dot(true), Pin { on: false, label: "pin" + "!" }, Gone]
  &marks.push(Pin { on: true, label: "two" })
  var ml = 0
  for mk in marks
    match mk
      Dot(on) | Pin { on, .. } if on => ml += 1
      Pin { label, .. } => ml += label.byte_len() * 10
      _ => ml += 100
  print(ml)
  // through a block that keeps one
  let held = Some(Item { name: "held" + "!", price: 5 })
  let get = fn() =>
    match held
      Some(i) => i.name
      None => "none"
  print(get())
