// Data stage, step 4: variant types of small sums, which a release build
// keeps as C structs: a tag and slots, or one object and no tag. A field
// of a variant type is read from its slot, an update keeps its tag, and
// `Rect { ..r }` is the same struct. `Shape`'s are kept in an array,
// inline; `Label` and `Pt`, which hold an object, never are, so they stay
// structs.

type Shape =
  | Dot
  | Circle { r: Int }
  | Rect { w: Int, h: Int }

type Label =
  | Blank
  | Named { text: Str }

type Pt =
  | Origin
  | At { x: Int, s: Str }

fn moved(p: Pt.At) -> Pt.At = { ..p, x: p.x + 1 }

fn grow(r: Shape.Rect, by: Int) -> Shape.Rect = { ..r, w: r.w + by }

fn area(s: Shape) -> Int =
  match s
    Rect { .. } as r => r.w * r.h
    Circle { r } => 3 * r * r
    Dot => 0

fn shout(n: Label.Named) -> Label.Named =
  var m = n
  m.text = m.text + "!"
  m

fn main() uses Console =
  var rects: Array<Shape.Rect> = []
  for s in [Rect { w: 1, h: 2 }, Dot, Circle { r: 2 }, Rect { w: 3, h: 4 }]
    match s
      Rect { .. } as r => &rects.push(grow(r, 10))
      _ => ()
  var sum = 0
  for r in rects
    sum += area(Rect { ..r })
    let { w, h } = r
    sum += w + h
  print(sum)
  print(rects)
  var l = Named { text: "a" }
  for _ in 0..3
    l = match l
      Named { .. } as n => Named { ..shout(n) }
      Blank => Blank
  print(l)
  var p: Pt = At { x: 0, s: "q" }
  for _ in 0..5
    p = match p
      At { .. } as a => At { ..moved(a) }
      Origin => Origin
  print(p)
  match p
    At { .. } as a =>
      let { s, .. } = a
      print(s)
      print(a.x)
    Origin => ()
