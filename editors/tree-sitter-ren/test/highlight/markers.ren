handler counting(rate: Int) for Rates, RateCalls uses Clock =
// <- keyword
//      ^ function
//                          ^ keyword
//                              ^ type.dependency
  var calls = 0
//^ keyword
  usd_to(_) =>
//^ function
    calls += 1
    rate
  count() => calls
//^ function

