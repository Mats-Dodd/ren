pub handler transaction() over Sql ! DbDown =
//                        ^ keyword
//                             ^ type.dependency
//                                 ^ keyword.failure
  let tx = try next.begin()
//             ^ variable.special
//                  ^ function.method
  finally(r) =>
//^ keyword
    N.next()
//    ^ function
    try r
  get() => next(Sql).get()
//         ^ variable.special

fn count() -> Int =
  var i = 0
  while i < 10
//^ keyword
    i += 1
    if i == 3 then break
//                 ^ keyword
  i

fn wrapped(s: over Sql) -> Int uses Sql =
//            ^ keyword
//                 ^ type
  with cached(1) over limited() over Sql, other() in 1
//               ^ keyword
//                    ^ function
//                                   ^ type.dependency

fn hash(b: UInt8) -> Int =
//         ^ type
  var h: UInt32 = 2166136261
//       ^ type
  h = h.xor(b) *% 16777619
//             ^ operator
  h +%= 1
//  ^ operator
  h = h.shl(0x1F) + 0b1010
//        ^ function.method
//            ^ number
//                   ^ number
  h

