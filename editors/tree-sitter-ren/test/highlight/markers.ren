fn pairs(xs: Array<Int>) -> Array<(Int, Int)> =
  var out = []
  for i in 0..xs.len() - 1
//^ keyword
//      ^ keyword
//          ^ operator
    let (a, b) = (xs[i], xs[i + 1])
//  ^ keyword
    &out.push((a, b))
  out

fn big(m: Map<Str, (Int, Bool)>) -> Map<Str, (Int, Bool)> =
  m.select(fn((k, (v, _))) => v > 1)
//             ^ variable.parameter
//                 ^ variable.parameter

