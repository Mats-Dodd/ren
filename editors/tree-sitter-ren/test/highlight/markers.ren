fn fetch(on: Tags) -> Int =
  try match get()
    fail on => try retry(3, on: Flaky | Down) fn() => get()
//  ^ keyword.failure
//       ^ variable.parameter
//                          ^ variable.parameter
//                              ^ constructor
//                                      ^ constructor
    v => v

fn halves(xs: Array<Int>, f: fn(&Array<Int>) -> Int) -> Int =
//                              ^ keyword.mutation
  var ys = xs[1..3]
//             ^ operator
  &ys.split_at(1) fn(&lo, &hi) => f(&lo) + hi.len()
//                   ^ keyword.mutation
//                    ^ variable.parameter

