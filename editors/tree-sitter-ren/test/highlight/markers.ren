// string and list patterns: literals are strings, a rest's `..` an
// operator
fn route(segs: Array<Str>) -> Str =
  match segs
    ["v1", ..rest] => "v1"
//   ^ string
//         ^ operator
    ["--out=" ..path] => path
//            ^ operator
    _ => ""
