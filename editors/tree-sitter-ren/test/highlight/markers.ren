// `todo` is a keyword: code still to write, of any type
fn first(o: Option<Int>) -> Int =
  let Some(n) = o else todo
//                     ^ keyword
  match n
    0 => todo
//       ^ keyword
    _ => n

// a chain: `|>` and its steps, each marked on its own
fn checkout(cart: Cart) -> Int ! Empty =
  cart
    |> try validate
//  ^ operator
//     ^ keyword.failure
//         ^ function
    |> price(1)
//     ^ function
    |> checkout.place
