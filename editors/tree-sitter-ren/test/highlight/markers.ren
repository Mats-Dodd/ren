//                   ^ constructor
//                         ^ property

fn sure(r: Result<Int, !>) -> Int = 1
//                     ^ keyword.failure

fn pay(t: Int) -> Int ! Refusal | bank.Late =
//                    ^ keyword.failure
//                                ^ namespace
//                                     ^ type
  if t < 0 then fail Short(t)
//              ^ keyword.failure
//                   ^ constructor
  let r = attempt send(t)
//        ^ keyword.failure
  let n = find(t) orelse fail Frozen
//                ^ keyword.failure
  try match send(t)
//^ keyword.failure
    _ => n
    fail Short(by) => by
//  ^ keyword.failure
//       ^ constructor

