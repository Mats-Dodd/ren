// Stage 4: `var`, `inout`, `&` and value semantics.

type Point = { x: Int, y: Int }

// Shift every score so the lowest is 0. `inout` updates the caller's array.
// The lowest is found by hand, to show `var` and `for`; `xs.min()` finds it too.
fn normalize(inout xs: Array<Int>) =
  var low = xs[0]
  for x in xs
    if x < low then low = x
  for x in &xs
    x -= low

fn nudge(inout p: Point, dx: Int) =
  p.x += dx

// By hand, to show `var` and `for`; `xs.sum()` does the same.
fn sum(xs) =
  var total = 0
  for x in xs
    total += x
  total

fn main() =
  var scores = [13, 11, 12]
  let before = scores                  // a value, not a reference
  normalize(&scores)                   // `&`: this call changes `scores`
  &scores.push(10)
  print(scores)
  print(before)                        // unchanged
  print(sum(scores))

  var p = Point { x: 1, y: 2 }
  let q = p
  nudge(&p, 10)
  p.y = 0
  print(p)
  print(q)

  var n = 1
  let get = fn() => n                  // a block reads `n` when it runs
  n = 2
  print(get())

  var total = 0
  scores.each(fn(x) => total += x)     // and can change a `var` outside it
  print(total)
