// Prices, refreshed in the background (async.md, "Prices, refreshed in
// the background"): a task beside the `with`'s body asks the supplier
// again every minute, and the table is never seen half-updated, since
// `refresh` keeps the instance until it has swapped the new one in.

pub dep Supplier =
  all: fn() -> Map<Str, Int> ! PricesDown

pub dep Prices =
  get: fn(item: Str) -> Option<Int>
  refresh: fn() ! PricesDown

// the supplier's table, asked for when it's installed and again on
// each `refresh`
pub handler refreshing() for Prices ! PricesDown uses Supplier =
  var table = try Supplier.all()
  get(item) => table.get(item)
  refresh() => table = try Supplier.all()

// prints each of `items`' prices four times, 25 seconds apart, while a
// task beside the body refreshes them every minute. When the body ends
// the refresher is cancelled and waited for, and then the `with` ends
pub fn shop(items: Array<Str>) ! PricesDown uses Supplier, Clock, Console, Async =
  try with refreshing() in
    Async.beside(fn() => refresher()) fn() =>
      for _ in 0..4
        for item in items
          print(Prices.get(item))
        Clock.sleep(Duration.seconds(25))

// refreshes the prices every minute, keeping the table when a refresh
// fails
fn refresher() =
  while true
    Clock.sleep(Duration.minutes(1))
    match attempt Prices.refresh()
      Ok(_) => ()
      Err(_) => Console.error("the refresh failed, so the table is kept")

// ---- tests ----

// a supplier whose prices go up by one each time it's asked, and that's
// down from its `down`th ask on
test handler rising(down: Int) for Supplier =
  var asked = 0
  all() =>
    asked += 1
    if asked >= down then fail PricesDown
    Map.of([("tea", asked), ("milk", 10 * asked)])

test "the table is refreshed every minute" =
  // asked at 0, 25, 50 and 75 seconds, and refreshed at 60
  with rising(100) in
    try shop(["tea"])
  assert TestConsole.output() == ["Some(1)", "Some(1)", "Some(1)", "Some(2)"]

test "a refresh that fails keeps the table" =
  with rising(2) in
    try shop(["tea", "milk"])
  assert TestConsole.output() == ["Some(1)", "Some(10)", "Some(1)", "Some(10)", "Some(1)", "Some(10)", "Some(1)", "Some(10)"]
  assert TestConsole.errors() == ["the refresh failed, so the table is kept"]

test "the refresher stops with the shop" =
  // the body ends at 100 seconds, and the refresher, asleep until 120,
  // is cancelled then
  with rising(100) in
    try shop([])
  assert Clock.now() == Time.epoch + Duration.seconds(100)

test "a supplier that's down at the start stops the shop" =
  with rising(1) in
    assert attempt shop(["tea"]) == Err(PricesDown)
  assert TestConsole.output() == []
