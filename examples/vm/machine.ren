// The machine: a program counter, a stack, four locals and the output so
// far. Everything it does is in `step`, which changes it, so every call is
// marked `&vm.step(p)`. It's a plain value: copy one, and the copy is a
// machine of its own.

import program.{Program}
import stack.{Stack}

pub type Status =
  | Running
  | Halted

// What can go wrong as it runs: an instruction needed a value the stack
// didn't have.
pub type Fault = ! Underflow(pc: Int)

pub type Vm = {
  pc: Int,
  stack: Stack<Int>,
  locals: Array<Int>,
  out: Array<Int>,
  steps: Int,
  status: Status,
}
  pub let fresh: Vm = Vm {
    pc: 0,
    stack: Stack.empty,
    locals: [0, 0, 0, 0],
    out: [],
    steps: 0,
    status: Running,
  }

  pub fn running(self) -> Bool = self.status == Running

  // Run one instruction.
  pub fn step(inout self, p: Program) ! Fault =
    self.steps += 1
    match p.at(self.pc)
      Push(n) => &self.push(n)
      Load(slot) =>
        // read into a `let` first: the call changes `self`, so no
        // argument can also reach into it
        let v = self.locals[slot]
        &self.push(v)
      Store(slot) =>
        let v = try &self.pop()
        self.locals[slot] = v
        self.pc += 1
      Add => try &self.binary(fn(a, b) => a + b)
      Sub => try &self.binary(fn(a, b) => a - b)
      Mul => try &self.binary(fn(a, b) => a * b)
      JumpIfZero(to) =>
        let v = try &self.pop()
        self.pc = if v == 0 then to else self.pc + 1
      Jump(to) => self.pc = to
      Emit =>
        let v = try &self.pop()
        &self.out.push(v)
        self.pc += 1
      Halt => self.status = Halted

  // Run until it halts or fails, or `fuel` steps have run.
  pub fn run(inout self, p: Program, fuel: Int) ! Fault =
    if fuel > 0 && self.running() then
      try &self.step(p)
      try &self.run(p, fuel - 1)

  fn push(inout self, n: Int) =
    &self.stack.push(n)
    self.pc += 1

  // the top of the stack, taken off; on an empty stack the machine fails
  fn pop(inout self) -> Int = &self.stack.pop() orelse fail Underflow(self.pc)

  fn binary(inout self, f: fn(Int, Int) -> Int) =
    let b = try &self.pop()
    let a = try &self.pop()
    &self.push(try f(a, b))
