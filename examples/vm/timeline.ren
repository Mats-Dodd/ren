// Every state a machine has been in, oldest first. Recording a state is
// `&self.frames.push(vm)`: a copy, so the machine can keep changing and
// what's recorded never does. That's the whole of time travel here.

import machine.{Fault, Vm}
import program.{Program}

pub type Timeline = opaque { frames: Array<Vm> }
  pub let empty: Timeline = Timeline { frames: [] }

  pub fn record(inout self, vm: Vm) = &self.frames.push(vm)

  pub fn len(self) -> Int = self.frames.len()

  // the machine as it was `n` steps before the last state recorded
  pub fn back(self, n: Int) -> Vm ! NotRecorded(n: Int) =
    self.frames.get(self.frames.len() - 1 - n) orelse fail NotRecorded(n)

  // Run `vm` like `Vm.run`, recording every state it passes through,
  // the last one too. Two things change, so the call has two `&`s:
  // `&tl.run(&vm, p, fuel)`. If the machine fails, what was recorded up
  // to then stays recorded.
  pub fn run(inout self, inout vm: Vm, p: Program, fuel: Int) ! Fault =
    &self.record(vm)
    if fuel > 0 && vm.running() then
      try &vm.step(p)
      try &self.run(&vm, p, fuel - 1)
