// A justfile: recipes, each with a name, the recipes it depends on, and
// the lines it runs.

pub type Recipe = { name: Str, deps: Array<Str>, lines: Array<Str> }

// It's opaque: `parse` checks what it's given, so a `Justfile` is only
// ever one that `parse` made.
pub type Justfile = opaque { recipes: Array<Recipe> }
  // The recipes in `text`. A line that isn't indented starts a recipe,
  // `name: deps`, and an indented one is a line of the recipe above it.
  // Blank lines and comments, after `#`, are skipped, and two recipes
  // can't share a name. Indices into a string are byte offsets, so
  // `slice` cuts where `index` found.
  pub fn parse(text: Str) -> Justfile ! BadLine(number: Int) | DuplicateRecipe(name: Str) =
    var recipes: Array<Recipe> = []
    var number = 0
    for line in text.split("\n")
      number += 1
      let t = line.trim()
      if t == "" || t.starts_with("#") then ()
      else if line.starts_with(" ") || line.starts_with("\t") then
        if recipes.len() == 0 then fail BadLine(number)
        &recipes[recipes.len() - 1].lines.push(t)
      else
        let colon = t.index(":") orelse fail BadLine(number)
        let name = t.slice(0, colon).trim()
        if name == "" then fail BadLine(number)
        if recipes.any(fn(r) => r.name == name) then fail DuplicateRecipe(name)
        // the dependencies, up to a comment, between spaces or tabs
        let rest = t.slice(colon + 1, t.len())
        let end = rest.index("#").unwrap_or(rest.len())
        var deps: Array<Str> = []
        for word in rest.slice(0, end).split(" ")
          for d in word.split("\t")
            if d != "" then &deps.push(d)
        &recipes.push(Recipe { name: name, deps: deps, lines: [] })
    Justfile { recipes: recipes }

  // every recipe, in the order they're written
  pub fn recipes(self) -> Array<Recipe> = self.recipes

  // the recipe called `name`
  pub fn recipe(self, name: Str) -> Recipe ! UnknownRecipe(name: Str) =
    self.recipes.find(fn(r) => r.name == name) orelse fail UnknownRecipe(name)

test "a recipe has a name, dependencies and lines" =
  let j = try Justfile.parse("# build it\nbuild: fmt  gen\n  cc -c a.c\n\n\tcc -o a a.o\nfmt:\n")
  assert j.recipes() == [
    Recipe { name: "build", deps: ["fmt", "gen"], lines: ["cc -c a.c", "cc -o a a.o"] },
    Recipe { name: "fmt", deps: [], lines: [] },
  ]

test "dependencies between tabs, and a comment after them" =
  let j = try Justfile.parse("a:\tb  c\t# not d\n  echo a\nb:\nc:\n")
  assert j.recipes()[0].deps == ["b", "c"]

test "two recipes with one name" =
  assert attempt Justfile.parse("a:\n  echo x\nb:\na:\n  echo y\n") == Err(DuplicateRecipe("a"))

test "a line that isn't a recipe or one of its lines" =
  assert attempt Justfile.parse("build:\n  make\nwhat is this\n") == Err(BadLine(3))
  assert attempt Justfile.parse("  make\n") == Err(BadLine(1))
