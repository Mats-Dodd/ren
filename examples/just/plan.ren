// The order to run recipes in: each one after the recipes it depends on,
// and each once, however many depend on it.

import justfile.{Justfile}

// every recipe `name` needs, then `name`
pub fn order(j: Justfile, name: Str) -> Array<Str> ! UnknownRecipe(name: Str) | Cycle(name: Str) =
  var started: Array<Str> = []
  var done: Array<Str> = []
  try visit(j, name, &started, &done)
  done

// The same recipes in levels, to run a level's at once: each recipe is in
// the level after the last one any of its dependencies is in, so a level
// depends only on the levels before it. Within a level they're in
// `order`'s order.
pub fn levels(j: Justfile, name: Str) -> Array<Array<Str>> ! UnknownRecipe(name: Str) | Cycle(name: Str) =
  var at: Map<Str, Int> = Map.empty
  var levels: Array<Array<Str>> = []
  for n in try order(j, name)
    // its dependencies are all in `at` already, since `order` put them
    // first
    var level = 0
    for d in (try j.recipe(n)).deps
      let below = at.get(d).unwrap_or(0) + 1
      if below > level then level = below
    &at.set(n, level)
    if level == levels.len() then &levels.push([])
    &levels[level].push(n)
  levels

// Depth first: a recipe goes into `done` after its dependencies. One
// that's started but not done is being visited further up, so reaching it
// again is a cycle.
fn visit(j: Justfile, name: Str, inout started: Array<Str>, inout done: Array<Str>) =
  if done.includes(name) then ()
  else
    if started.includes(name) then fail Cycle(name)
    &started.push(name)
    let r = try j.recipe(name)
    for d in r.deps
      try visit(j, d, &started, &done)
    &done.push(name)

test "dependencies come first, in the order they're written" =
  let j = try Justfile.parse("all: build test\nbuild: fmt\ntest:\nfmt:\n")
  assert try order(j, "all") == ["fmt", "build", "test", "all"]
  assert try order(j, "build") == ["fmt", "build"]

test "a dependency shared by two runs once" =
  let j = try Justfile.parse("all: left right\nleft: base\nright: base\nbase:\n")
  assert try order(j, "all") == ["base", "left", "right", "all"]

test "a recipe that isn't there" =
  let j = try Justfile.parse("all: build\n")
  assert attempt order(j, "all") == Err(UnknownRecipe("build"))

test "a recipe that depends on itself" =
  let j = try Justfile.parse("a: b\nb: a\n")
  assert attempt order(j, "a") == Err(Cycle("a"))

test "levels: each recipe after the level of what it depends on" =
  let j = try Justfile.parse("all: left right\nleft: base\nright: base\nbase:\n")
  assert try levels(j, "all") == [["base"], ["left", "right"], ["all"]]
  assert try levels(j, "left") == [["base"], ["left"]]

test "levels: a recipe deeper on one side waits for it" =
  let j = try Justfile.parse("all: a c\na: b\nb:\nc:\n")
  assert try levels(j, "all") == [["b", "c"], ["a"], ["all"]]
