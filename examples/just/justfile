# What `ren run main.ren` runs, from the folder this is in.

# the first recipe, so the one that runs with no args: `build` and
# `test` both need only `base`, so they run at once
all: build test
  echo all done

build: base
  echo building
  echo built

# waits a moment first, so `build` has printed by the time it does
test: base
  sleep 0.5
  echo testing

base:
  echo base

# exits with 3 halfway through, so its last line never runs
broken: base
  echo trying
  exit 3
  echo never

# `broken` fails while `slow` runs, which is killed then
ci: broken slow

slow: base
  sleep 5.0; true
  echo never
