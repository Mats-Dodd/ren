// Rate limiters: a fixed window, at most `limit` calls in each `window`
// of time, and a token bucket, which spreads them out evenly.

pub dep Limiter =
  // let one call through, or say when the next one can be made
  take: fn() ! Throttled(until: Instant)


// a limiter that lets everything through
pub handler none() for Limiter =
  take() => ()

// at most `limit` calls in each `window` of time; each window starts at
// the first call after the last one ended
pub handler fixed_window(limit: Int, window: Duration) for Limiter uses Clock =
  var start = Clock.instant()
  var used = 0
  take() =>
    let now = Clock.instant()
    if now >= start + window then
      start = now
      used = 0
    if used == limit then fail Throttled(start + window)
    used += 1

// up to `burst` calls at once, and then one more each time `every` goes
// by: a token for each call, and a new one every `every`, up to `burst`
pub handler token_bucket(burst: Int, every: Duration) for Limiter uses Clock =
  var tokens = burst
  // when the last token was added
  var added = Clock.instant()
  take() =>
    let gained = (Clock.instant() - added).in_ms() / every.in_ms()
    if gained > 0 then
      tokens = if tokens + gained > burst then burst else tokens + gained
      added = added + every * gained
    if tokens == 0 then fail Throttled(added + every)
    tokens -= 1

test "calls up to the limit go through" =
  with fixed_window(2, Duration.seconds(1)) in
    try Limiter.take()
    try Limiter.take()

test "one more is throttled until the window ends" =
  with fixed_window(2, Duration.seconds(1)) in
    try Limiter.take()
    try Limiter.take()
    assert attempt Limiter.take() == Err(Throttled(Instant.zero + Duration.seconds(1)))

test "a new window lets calls through again" =
  with fixed_window(1, Duration.seconds(1)) in
    try Limiter.take()
    TestClock.advance(Duration.seconds(1))
    try Limiter.take()

test "a burst goes through, and then one call each time a token comes" =
  with token_bucket(2, Duration.ms(500)) in
    try Limiter.take()
    try Limiter.take()
    assert attempt Limiter.take() == Err(Throttled(Instant.zero + Duration.ms(500)))
    TestClock.advance(Duration.ms(500))
    try Limiter.take()
    assert attempt Limiter.take() == Err(Throttled(Instant.zero + Duration.seconds(1)))

test "tokens build up to the burst, and no more" =
  with token_bucket(2, Duration.ms(500)) in
    try Limiter.take()
    try Limiter.take()
    TestClock.advance(Duration.seconds(10))
    try Limiter.take()
    try Limiter.take()
    assert attempt Limiter.take() == Err(Throttled(Instant.zero + Duration.ms(10500)))
