// Prices from a slow supplier that answers twice a second at most, kept
// for ten seconds so most asks never reach it. README.md says what to
// look at.

import limiter
import cache.{Supplier, Prices}

// a supplier that takes a moment to answer
fn catalogue() = Supplier { quote: fn(item) =>
    Clock.sleep(Duration.ms(20))
    if item == "apple" then 3
    else if item == "pear" then 5
    else if item == "fig" then 8
    else fail Unknown(item)
}

// a price, or what stopped it
fn show_price(item: Str) uses Prices, Console =
  match Prices.price(item)
    p => print(p)
    fail Unknown(_) => print("unknown")
    fail Throttled(_) => print("throttled")

fn main() uses Clock, Console =
  with catalogue(),
      limiter.fixed_window(2, Duration.seconds(1)),
      cache.cached(Duration.seconds(10)) in
    show_price("apple")  // 3, from the supplier
    show_price("apple")  // 3, from the cache
    show_price("pear")   // 5, from the supplier: that's two this second
    show_price("fig")    // throttled
    Clock.sleep(Duration.seconds(1))
    show_price("fig")    // 8
    show_price("plum")   // unknown

test "main prints each price, or what stopped it" =
  main()
  assert TestConsole.output() == ["3", "3", "5", "throttled", "8", "unknown"]
