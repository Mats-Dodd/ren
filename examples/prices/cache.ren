// Prices, from a supplier that's slow and limits how often it's asked, so
// each answer is kept for a while. An entry older than `ttl` is asked for
// again.
//
// A handler can't call the dependency it implements until `outer`
// (stage 10), so the cache can't sit in front of another `Prices`: what it
// asks is a dependency of its own, `Supplier`.

import limiter.{Limiter}

pub dep Supplier =
  quote: fn(item: Str) -> Int ! Unknown(item: Str)

pub dep Prices =
  price: fn(item: Str) -> Int ! Unknown(item: Str) | Throttled(until: Instant)

// a price, and until when it's kept
type Entry = { price: Int, until: Instant }

// at most `ttl` old, and the supplier asked only past the limiter
pub handler cached(ttl: Duration) for Prices uses Supplier, Limiter, Clock =
  var entries: Map<Str, Entry> = Map.empty
  price(item) =>
    let now = Clock.instant()
    match entries.get(item)
      Some(e) if now < e.until => e.price
      _ =>
        try Limiter.take()
        let p = try Supplier.quote(item)
        &entries.set(item, Entry { price: p, until: now + ttl })
        p

// ---- tests ----

// `pub`, though only the tests use it: a test item is a function or a
// handler, so a dependency they share is part of the interface
pub dep Calls =
  // how many times the supplier has been asked
  count: fn() -> Int

// a supplier that knows two prices, and counts how often it's asked
test handler counting() for Supplier, Calls =
  var n = 0
  quote(item) =>
    n += 1
    if item == "apple" then 3
    else if item == "pear" then 5
    else fail Unknown(item)
  count() => n

test "a second ask is answered from the cache" =
  with counting(), Limiter.none, cached(Duration.seconds(10)) in
    assert try Prices.price("apple") == 3
    assert try Prices.price("apple") == 3
    assert Calls.count() == 1

test "an old entry is asked for again" =
  with counting(), Limiter.none, cached(Duration.seconds(10)) in
    let _ = try Prices.price("apple")
    TestClock.advance(Duration.seconds(10))
    let _ = try Prices.price("apple")
    assert Calls.count() == 2

test "an unknown item isn't kept" =
  with counting(), Limiter.none, cached(Duration.seconds(10)) in
    assert attempt Prices.price("plum") == Err(Unknown("plum"))
    assert attempt Prices.price("plum") == Err(Unknown("plum"))
    assert Calls.count() == 2

test "a cached answer doesn't count against the limit" =
  with counting(),
      limiter.fixed_window(1, Duration.seconds(1)),
      cached(Duration.seconds(10)) in
    assert try Prices.price("apple") == 3
    assert try Prices.price("apple") == 3
    assert attempt Prices.price("pear") == Err(Throttled(Instant.zero + Duration.seconds(1)))
