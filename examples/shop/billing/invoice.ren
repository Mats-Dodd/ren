// Invoices. `Plan` is imported by name, so it's written bare here, and
// `plan.price` is still written with its module.
//
// `Free` is a constructor of both `Plan` and `Status`. Each `Free` below
// is found through the type expected where it's written.

import plan.{Plan}
import billing/stripe

pub type Status =
  | Due(amount: Int)
  | Free
  | Paid { amount: Int, charge: stripe.ChargeId }

pub type Invoice = { plan: Plan, status: Status }

pub fn make(p: Plan) -> Invoice =
  let amount = plan.price(p)
  { plan: p, status: if amount == 0 then Free else Due(amount) }

// the invoice, paid: only one that's due can be, and the card can decline
pub fn pay(i: Invoice) -> Invoice ! Declined(amount: Int) | NothingDue
    uses Console =
  let Due(amount) = i.status else fail NothingDue
  { ..i, status: Paid { amount, charge: try stripe.charge(amount) } }

test "a paid invoice keeps its plan, and what it was charged" =
  let i = try pay(make(Pro(2)))
  assert i.plan == Pro(2)
  assert match i.status
    Paid { amount, .. } => amount == 20
    _ => false

test "a free invoice has nothing to pay" =
  assert attempt pay(make(Free)) == Err(NothingDue)
