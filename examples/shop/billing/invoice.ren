// Invoices. `Plan` is imported by name, so it's written bare here, and
// `plan.price` is still written with its module.
//
// `Free` is a constructor of both `Plan` and `Status`. Each `Free` below
// is found through the type expected where it's written.

import plan.{Plan}
import billing/stripe

pub type Status =
  | Due(amount: Int)
  | Free

pub type Invoice = { plan: Plan, status: Status }

pub fn make(p: Plan) -> Invoice =
  let amount = plan.price(p)
  { plan: p, status: if amount == 0 then Free else Due(amount) }

pub fn pay(i: Invoice) -> Option<stripe.ChargeId>
    uses Io =
  match i.status
    Free => None
    Due(amount) => Some(stripe.charge(amount))
