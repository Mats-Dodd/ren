// A shop of six modules: this one, plan.ren, cart.ren, users.ren, and
// billing/invoice.ren and billing/stripe.ren in a folder. `ren types
// main.ren` shows them all.

import plan.{Plan}
import cart.{Cart}
import users.{UserId}
import billing/invoice
import billing/stripe

// the receipt, or 0 if there was nothing to pay or the card was declined
fn checkout(p: Plan) =
  match invoice.pay(invoice.make(p))
    Some(id) => stripe.receipt(id)
    None => 0
    fail Declined(_) => 0

fn main() =
  let free: Plan = Free
  print(invoice.make(free))
  print(checkout(free))

  var c = Cart.of(UserId.new(7))
  &c.put(Free)
  &c.put(Pro(3))
  print(c.owner().raw())
  print(c.len())
  print(c.total())
  print(Cart.guest.len())
  &c.clear()
  print(c.len())
  print(checkout(Pro(20)))   // declined: over the card's limit
  checkout(Pro(3))
