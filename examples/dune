; examples.t runs every example with `ren run` and checks what it prints.
; Each folder is a program of several modules. just.t runs examples/just
; on a real justfile, records and replays it, and runs its tests, one from
; the journal checked in; journal.t runs the journal's commands on small
; programs; console.t runs `ren console` in bank and prices.

(cram
 (deps
  %{bin:ren}
  (glob_files *.ren)
  (glob_files two/*.ren)
  (glob_files shop/*.ren)
  (glob_files shop/billing/*.ren)
  (glob_files vm/*.ren)
  (glob_files bank/*.ren)
  (glob_files prices/*.ren)
  (glob_files ledger/*.ren)
  (glob_files just/*.ren)
  (glob_files just/tests/*.journal)
  just/justfile))
