// A bank: accounts, transfers that can fail, and batches that go through
// whole or not at all. README.md next to this file says what to look at.

import money.{Money}
import account.{AccountId}
import bank.{Bank, Transfer, TransferError}

// `pub`, with its whole contract, so the test below can call it: a test
// sees what an importer sees
pub fn main() ! TransferError uses Clock, Console =
  var acme = Bank.empty
  let alice = &acme.open()
  let bob = &acme.open()
  let carol = &acme.open()
  try &acme.deposit(alice, Money.dollars(100))
  try &acme.deposit(bob, Money.dollars(20))

  // $30 from Alice to Bob: it goes through
  try &acme.transfer(send(alice, bob, 30))
  print(try cents(acme, alice))                   // 7000
  print(try cents(acme, bob))                     // 5000

  // $500 from Bob, who has $50: it fails, and nothing moves. `attempt`
  // keeps the outcome as a value, to print it and decide on it later.
  let r = attempt &acme.transfer(send(bob, carol, 500))
  print(r)                                        // Err(Short(2, 45000))
  print(try cents(acme, bob))                     // 5000
  print(worth_retrying(r))                        // true

  // Carol's account is frozen, so it can't take money in. Alice's side
  // went through on a copy of her account, which was never set back. The
  // `match` handles every way the transfer can fail.
  try &acme.freeze(carol)
  match &acme.transfer(send(alice, carol, 10))
    _ => print(0)
    fail Frozen(id) => print(id)                  // 3
    fail Short(_, by) => print(by)
    fail NoSuchAccount(_) | fail NotPositive(_) | fail SameAccount => print(-1)
  print(try cents(acme, alice))                   // 7000

  // A batch where the last transfer fails: none of them happen.
  let before = acme
  print(attempt &acme.batch([
    send(alice, bob, 10),
    send(bob, alice, 5),
    send(bob, carol, 1),
  ]))                                             // Err(Frozen(3))
  print(acme == before)                           // true

  // The same batch without Carol: all of it happens.
  print(attempt &acme.batch([send(alice, bob, 10), send(bob, alice, 5)]))   // Ok(())
  print(try cents(acme, alice))                   // 6500
  print(try cents(acme, bob))                     // 5500

  // Transfers move money, never make it: the total is what was deposited.
  print(acme.total() == Money.dollars(120))       // true
  print(try acme.statement(bob).len())            // 4

  // Every entry is stamped with Clock.now(), so a statement is in order.
  let s = try acme.statement(bob)
  print(s[3].at >= s[0].at)                       // true

fn send(from: AccountId, to: AccountId, dollars: Int) -> Transfer =
  Transfer { from, to, amount: Money.dollars(dollars) }

fn cents(b: Bank, id: AccountId) -> Int = try b.balance(id).in_cents()

// whether asking again later could work
fn worth_retrying(r: Result<Unit, ! TransferError>) -> Bool =
  match r
    Ok(_) => false
    Err(Short(_, _)) => true
    Err(Frozen(_)) => true
    Err(NoSuchAccount(_)) => false
    Err(NotPositive(_)) => false
    Err(SameAccount) => false

// `main` runs here with the test `Console`, which keeps what it prints
test "main prints the balances, and every refusal" =
  try main()
  assert TestConsole.output() == [
    "7000", "5000",
    "Err(Short(AccountId(2), Money(45000)))", "5000", "true",
    "AccountId(3)", "7000",
    "Err(Frozen(AccountId(3)))", "true",
    "Ok(())", "6500", "5500",
    "true", "4", "true",
  ]
