// The bank: every account, and the only way to change them.
//
// A transfer changes two accounts, and either change can fail. So it works
// on a copy of the bank, `var draft = self`, and only if nothing failed
// does the copy become the bank, `self = draft`. A failure halfway leaves
// the bank as it was, with nothing to undo: what the failed call changed
// stays changed, but only in the draft. `batch` does the same for many
// transfers: all of them, or none.

import money.{Money}
import account.{Account, AccountId, Refusal, Entry}

pub type Transfer = { from: AccountId, to: AccountId, amount: Money }

// every way a transfer can fail
pub type TransferError = ! Refusal | NoSuchAccount(account: AccountId) | NotPositive(amount: Money) | SameAccount

pub type Bank = { accounts: Array<Account>, next: Int }
  pub let empty: Bank = Bank { accounts: [], next: 1 }

  pub fn open(inout self) -> AccountId =
    let id = AccountId.of(self.next)
    self.next += 1
    &self.accounts.push(Account.open(id))
    id

  // A deposit can't be short, so it doesn't say it can: its signature
  // lists exactly what it fails with.
  pub fn deposit(inout self, to: AccountId, m: Money) ! Frozen(account: AccountId) | NoSuchAccount(account: AccountId) | NotPositive(amount: Money) uses Clock =
    if not m.positive() then fail NotPositive(m)
    let i = try self.find(to)
    try &self.accounts[i].credit(m, Deposited(m))

  pub fn transfer(inout self, t: Transfer) ! TransferError uses Clock =
    if t.from == t.to then fail SameAccount
    if not t.amount.positive() then fail NotPositive(t.amount)
    let i = try self.find(t.from)
    let j = try self.find(t.to)
    var draft = self
    try &draft.accounts[i].debit(t.amount, Sent(t.amount, t.to))
    try &draft.accounts[j].credit(t.amount, Received(t.amount, t.from))
    self = draft

  // every transfer, or, if one fails, none of them
  pub fn batch(inout self, ts: Array<Transfer>) ! TransferError uses Clock =
    var draft = self
    for t in ts
      try &draft.transfer(t)
    self = draft

  pub fn freeze(inout self, id: AccountId) ! NoSuchAccount(account: AccountId) =
    let i = try self.find(id)
    self.accounts[i].frozen = true

  pub fn balance(self, id: AccountId) -> Money ! NoSuchAccount(account: AccountId) =
    let i = try self.find(id)
    self.accounts[i].balance

  pub fn statement(self, id: AccountId) -> Array<Entry> ! NoSuchAccount(account: AccountId) =
    let i = try self.find(id)
    self.accounts[i].statement

  // all the money in the bank: only deposits change it
  pub fn total(self) -> Money =
    var sum = Money.zero
    for a in self.accounts
      sum = sum.plus(a.balance)
    sum

  // where the account is in `accounts`. It's private, so what it fails
  // with is worked out, not written.
  fn find(self, id: AccountId) -> Int =
    var found = None
    var i = 0
    for a in self.accounts
      if a.id == id then found = Some(i)
      i += 1
    found orelse fail NoSuchAccount(id)

// The tests get the test `Clock`, stopped at `Time.epoch` until a test
// moves it, and the test `Console`, without a `with`. Each refusal is kept
// with `attempt`, to check it's the one expected and that nothing moved.
// `Err(...)` can't be written, since an error isn't a value, so a test
// looks at the `Result` with a `match`.

test "a deposit is stamped with the time" =
  var acme = Bank.empty
  let a = &acme.open()
  TestClock.advance(Duration.minutes(5))
  try &acme.deposit(a, Money.dollars(10))
  let s = try acme.statement(a)
  assert s[0].at == Time.epoch.plus(Duration.minutes(5))

test "a transfer moves money, and stamps both sides" =
  var acme = Bank.empty
  let a = &acme.open()
  let b = &acme.open()
  try &acme.deposit(a, Money.dollars(10))
  TestClock.advance(Duration.seconds(1))
  try &acme.transfer(Transfer { from: a, to: b, amount: Money.dollars(4) })
  let now = Time.epoch.plus(Duration.seconds(1))
  assert try acme.statement(a) == [
    Entry { at: Time.epoch, what: Deposited(Money.dollars(10)) },
    Entry { at: now, what: Sent(Money.dollars(4), b) },
  ]
  assert try acme.statement(b) == [Entry { at: now, what: Received(Money.dollars(4), a) }]

test "an overdraft is refused, and nothing moves" =
  var acme = Bank.empty
  let a = &acme.open()
  let b = &acme.open()
  try &acme.deposit(a, Money.dollars(10))
  let before = acme
  let r = attempt &acme.transfer(Transfer { from: a, to: b, amount: Money.dollars(11) })
  assert acme == before
  match r
    Err(Short(id, by)) => assert id == a && by == Money.dollars(1)
    _ => assert false

test "a frozen account takes nothing in" =
  var acme = Bank.empty
  let a = &acme.open()
  try &acme.freeze(a)
  match attempt &acme.deposit(a, Money.dollars(10))
    Err(Frozen(id)) => assert id == a
    _ => assert false
  assert try acme.balance(a) == Money.zero

test "an account that doesn't exist is refused" =
  var acme = Bank.empty
  let a = &acme.open()
  let nobody = AccountId.of(99)
  match attempt &acme.transfer(Transfer { from: a, to: nobody, amount: Money.dollars(1) })
    Err(NoSuchAccount(id)) => assert id == nobody
    _ => assert false

test "only a positive amount moves" =
  var acme = Bank.empty
  let a = &acme.open()
  match attempt &acme.deposit(a, Money.zero)
    Err(NotPositive(m)) => assert m == Money.zero
    _ => assert false

test "an account can't send to itself" =
  var acme = Bank.empty
  let a = &acme.open()
  try &acme.deposit(a, Money.dollars(10))
  match attempt &acme.transfer(Transfer { from: a, to: a, amount: Money.dollars(1) })
    Err(SameAccount) => ()
    _ => assert false

test "a batch that fails moves nothing" =
  var acme = Bank.empty
  let a = &acme.open()
  let b = &acme.open()
  try &acme.deposit(a, Money.dollars(10))
  let before = acme
  let there = Transfer { from: a, to: b, amount: Money.dollars(5) }
  let back = Transfer { from: b, to: a, amount: Money.dollars(6) }
  let r = attempt &acme.batch([there, back])
  assert acme == before
  match r
    Err(Short(id, by)) => assert id == b && by == Money.dollars(1)
    _ => assert false
