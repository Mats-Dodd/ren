// The bank: every account, by its id, and the only way to change them.
// It's opaque, so that's so: a transfer keeps the total, and nothing
// outside this module can change an account but through it.
//
// An account is changed the way any value in a `Map` is: get it, change
// the copy, and set it back. A transfer changes two accounts, and either
// change can fail, so it sets them back only once both went through. A
// failure halfway leaves the bank as it was, with nothing to undo: what
// the failed call changed stays changed, but only in the copy. `batch`
// does the same for many transfers, on a copy of the whole bank, `var
// draft = self`, which becomes the bank, `self = draft`, only if nothing
// failed: all of them, or none.

import money.{Money}
import account.{Account, AccountId, Refusal, Entry}

pub type Transfer = { from: AccountId, to: AccountId, amount: Money }

// every way a transfer can fail
pub type TransferError = ! Refusal | NoSuchAccount(account: AccountId) | NotPositive(amount: Money) | SameAccount

pub type Bank = opaque { accounts: Map<AccountId, Account>, next: Int }
  pub let empty: Bank = Bank { accounts: Map.empty, next: 1 }

  pub fn open(inout self) -> AccountId =
    let id = AccountId.of(self.next)
    self.next += 1
    &self.accounts.set(id, Account.open(id))
    id

  // A deposit can't be short, so it doesn't say it can: its signature
  // lists exactly what it fails with.
  pub fn deposit(inout self, to: AccountId, m: Money) ! Frozen(account: AccountId) | NoSuchAccount(account: AccountId) | NotPositive(amount: Money) uses Clock =
    if not m.positive() then fail NotPositive(m)
    var a = try self.get(to)
    try &a.credit(m, Deposited(m))
    &self.accounts.set(to, a)

  pub fn transfer(inout self, t: Transfer) ! TransferError uses Clock =
    if t.from == t.to then fail SameAccount
    if not t.amount.positive() then fail NotPositive(t.amount)
    var from = try self.get(t.from)
    var to = try self.get(t.to)
    try &from.debit(t.amount, Sent { amount: t.amount, to: t.to })
    try &to.credit(t.amount, Received { amount: t.amount, from: t.from })
    &self.accounts.set(t.from, from)
    &self.accounts.set(t.to, to)

  // every transfer, or, if one fails, none of them
  pub fn batch(inout self, ts: Array<Transfer>) ! TransferError uses Clock =
    var draft = self
    for t in ts
      try &draft.transfer(t)
    self = draft

  pub fn freeze(inout self, id: AccountId) ! NoSuchAccount(account: AccountId) =
    var a = try self.get(id)
    &a.freeze()
    &self.accounts.set(id, a)

  pub fn balance(self, id: AccountId) -> Money ! NoSuchAccount(account: AccountId) =
    let a = try self.get(id)
    a.balance()

  pub fn statement(self, id: AccountId) -> Array<Entry> ! NoSuchAccount(account: AccountId) =
    let a = try self.get(id)
    a.statement()

  // all the money in the bank: only deposits change it
  pub fn total(self) -> Money = self.accounts.values().map(fn(a) => a.balance()).sum()

  // the account `id`, a copy. It's private, so what it fails with is
  // worked out, not written.
  fn get(self, id: AccountId) -> Account =
    self.accounts.get(id) orelse fail NoSuchAccount(id)

// The tests get the test `Clock`, stopped at `Time.epoch` until a test
// moves it, and the test `Console`, without a `with`. Each refusal is kept
// with `attempt`, to check it's the one expected and that nothing moved:
// the error it expects is written inside `Err`, by its tag.

test "a deposit is stamped with the time" =
  var acme = Bank.empty
  let a = &acme.open()
  TestClock.advance(Duration.minutes(5))
  try &acme.deposit(a, Money.dollars(10))
  let s = try acme.statement(a)
  assert s[0].at == Time.epoch + Duration.minutes(5)

test "a transfer moves money, and stamps both sides" =
  var acme = Bank.empty
  let a = &acme.open()
  let b = &acme.open()
  try &acme.deposit(a, Money.dollars(10))
  TestClock.advance(Duration.seconds(1))
  try &acme.transfer(Transfer { from: a, to: b, amount: Money.dollars(4) })
  let now = Time.epoch + Duration.seconds(1)
  assert try acme.statement(a) == [
    Entry { at: Time.epoch, what: Deposited(Money.dollars(10)) },
    Entry { at: now, what: Sent { amount: Money.dollars(4), to: b } },
  ]
  assert try acme.statement(b) == [
    Entry { at: now, what: Received { amount: Money.dollars(4), from: a } },
  ]

test "an overdraft is refused, and nothing moves" =
  var acme = Bank.empty
  let a = &acme.open()
  let b = &acme.open()
  try &acme.deposit(a, Money.dollars(10))
  let before = acme
  let r = attempt &acme.transfer(Transfer { from: a, to: b, amount: Money.dollars(11) })
  assert acme == before
  assert r == Err(Short(a, Money.dollars(1)))

test "a frozen account takes nothing in" =
  var acme = Bank.empty
  let a = &acme.open()
  try &acme.freeze(a)
  assert attempt &acme.deposit(a, Money.dollars(10)) == Err(Frozen(a))
  assert try acme.balance(a) == Money.zero

test "an account that doesn't exist is refused" =
  var acme = Bank.empty
  let a = &acme.open()
  let nobody = AccountId.of(99)
  let t = Transfer { from: a, to: nobody, amount: Money.dollars(1) }
  assert attempt &acme.transfer(t) == Err(NoSuchAccount(nobody))

test "only a positive amount moves" =
  var acme = Bank.empty
  let a = &acme.open()
  assert attempt &acme.deposit(a, Money.zero) == Err(NotPositive(Money.zero))

test "an account can't send to itself" =
  var acme = Bank.empty
  let a = &acme.open()
  try &acme.deposit(a, Money.dollars(10))
  let t = Transfer { from: a, to: a, amount: Money.dollars(1) }
  assert attempt &acme.transfer(t) == Err(SameAccount)

test "a batch that fails moves nothing" =
  var acme = Bank.empty
  let a = &acme.open()
  let b = &acme.open()
  try &acme.deposit(a, Money.dollars(10))
  let before = acme
  let there = Transfer { from: a, to: b, amount: Money.dollars(5) }
  let back = Transfer { from: b, to: a, amount: Money.dollars(6) }
  let r = attempt &acme.batch([there, back])
  assert acme == before
  assert r == Err(Short(b, Money.dollars(1)))
