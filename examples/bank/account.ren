// One customer's account: its balance, whether it's frozen, and its
// statement, every change to it in order, each stamped with when it
// happened. It keeps rules, never below zero and nothing into a frozen
// one, so it's opaque: only this module sees its fields, and everyone
// else reads and changes it through its methods.

import money.{Money}

pub type AccountId = opaque Int
  pub fn of(n: Int) -> AccountId = n

// Why an account said no. It's a set of error tags, not a type of values:
// `debit` can fail with either, and `credit` only with `Frozen`.
pub type Refusal = ! Short(account: AccountId, by: Money) | Frozen(account: AccountId)

// what moved money in or out
pub type Movement =
  | Deposited(amount: Money)
  | Sent { amount: Money, to: AccountId }
  | Received { amount: Money, from: AccountId }

// a line of a statement: a movement, and when it happened, by whichever
// clock is installed
pub type Entry = { at: Time, what: Movement }

pub type Account = opaque {
  id: AccountId,
  balance: Money,
  frozen: Bool,
  statement: Array<Entry>,
}
  pub fn open(id: AccountId) -> Account = Account {
    id,
    balance: Money.zero,
    frozen: false,
    statement: [],
  }

  // what it has, and every change to it so far: each reads the field of
  // its name, which only this module can
  pub fn balance(self) -> Money = self.balance
  pub fn statement(self) -> Array<Entry> = self.statement

  // a frozen account takes nothing in and lets nothing out
  pub fn freeze(inout self) = self.frozen = true

  // money in, unless the account is frozen. Stamping the entry reads the
  // clock, so the signature says `uses Clock`.
  pub fn credit(inout self, m: Money, what: Movement) ! Frozen(account: AccountId) uses Clock =
    if self.frozen then fail Frozen(self.id)
    self.balance = self.balance + m
    &self.statement.push(Entry { at: Clock.now(), what })

  // money out, unless it's frozen or there isn't enough
  pub fn debit(inout self, m: Money, what: Movement) ! Refusal uses Clock =
    if self.frozen then fail Frozen(self.id)
    if self.balance < m then fail Short(self.id, m - self.balance)
    self.balance = self.balance - m
    &self.statement.push(Entry { at: Clock.now(), what })

// The tests are this module's clients: they see what `bank.ren` sees, its
// `pub` items, and an `Account` only through its methods.

test "a new account is empty" =
  let a = Account.open(AccountId.of(1))
  assert a.balance() == Money.zero
  assert a.statement() == []

test "a frozen account takes nothing in" =
  var a = Account.open(AccountId.of(1))
  &a.freeze()
  assert attempt &a.credit(Money.dollars(5), Deposited(Money.dollars(5))) == Err(Frozen(AccountId.of(1)))
  assert a.balance() == Money.zero

test "a debit can't go below zero" =
  var a = Account.open(AccountId.of(1))
  try &a.credit(Money.dollars(5), Deposited(Money.dollars(5)))
  let out = Sent { amount: Money.dollars(7), to: AccountId.of(2) }
  assert attempt &a.debit(Money.dollars(7), out) == Err(Short(AccountId.of(1), Money.dollars(2)))
  assert a.balance() == Money.dollars(5)

test "each change is stamped with the time" =
  var a = Account.open(AccountId.of(1))
  TestClock.advance(Duration.seconds(3))
  try &a.credit(Money.dollars(5), Deposited(Money.dollars(5)))
  assert a.statement() == [Entry { at: Time.epoch + Duration.seconds(3), what: Deposited(Money.dollars(5)) }]
